function getLastReportRow(sheet) {
  const lastContentRow = Math.max(1, sheet.getLastRow());
  const values = sheet
    .getRange(1, 13, lastContentRow, 1)
    .getDisplayValues();

  for (let i = values.length - 1; i >= 0; i--) {
    if (values[i][0] !== "") return i + 1;
  }

  return 1;
}

function clearReportRenderArea(sheet) {
  const reportRenderRange = sheet.getRange(
    1,
    13,
    sheet.getMaxRows(),
    6,
  );

  // Content may already have been erased by the clean-slate protocol, so the
  // previous report height can no longer be inferred from column M. Clear the
  // entire dedicated report area, including merges and borders, before redraw.
  reportRenderRange.breakApart();
  reportRenderRange.clearContent().clearFormat();
  reportRenderRange
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TABLE_BODY);
}

function calc() {
  const sheet =
    SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1");
  const data = getFormResponseData(sheet);
  const today = new Date();
  const todayStr = today.toDateString();
  const month = today.getMonth();
  const year = today.getFullYear();
  const zeenahMap = {};

  const empMap = {};
  const empLastWorkToday = {};
  const foremanMap = {};
  const companyMap = {};
  const oilMap = {};

  let totalTodayIncl = 0,
    totalMonthIncl = 0;
  let totalTodayExcl = 0,
    totalMonthExcl = 0;
  let carsTodayIncl = 0,
    carsMonthIncl = 0;
  let carsTodayExcl = 0,
    carsMonthExcl = 0;
  const companyJobs = {};

  for (let i = 1; i < data.length; i++) {
    const [
      timestamp,
      foreman,
      employee,
      licensePlate,
      service,
      serviceFee,
      company,
      oilChange,
      companyDetail,
      specialPrice,
    ] = data[i];
    if (!timestamp) continue;
    let serviceAmt = 0;
    if (serviceFee && serviceFee.toString().trim().toLowerCase() !== "free") {
      serviceAmt = parseFloat(serviceFee) || 0;
    }

    let actualAmt;
    if (
      specialPrice !== "" &&
      specialPrice !== null &&
      specialPrice !== undefined
    ) {
      actualAmt = parseFloat(specialPrice) || 0; // if 0 entered, that's still valid
    } else {
      actualAmt = serviceAmt; // fallback to service fee if no special price
    }

    const companyName = (company || "").toString().trim();

    if (companyName) {
      if (!companyJobs[companyName]) companyJobs[companyName] = [];

      companyJobs[companyName].push([
        timestamp,
        foreman,
        employee,
        licensePlate,
        service,
        actualAmt,
        companyName,
        oilChange,
        companyDetail,
      ]);
    }

    // Skip blank rows completely
    const date = new Date(timestamp);

    const empNames = (employee || "")
      .toString()
      .split(/,|\s+/) // split by comma OR any space(s)
      .map((e) => e.trim())
      .filter((e) => e !== "");
    const foremanName = (foreman || "").toString().trim();

    // Skip any row with missing names (prevents "Unknown")
    if (empNames.length === 0 || !foremanName) continue;

    const isToday = date.toDateString() === todayStr;
    const isThisMonth =
      date.getMonth() === month && date.getFullYear() === year;
    const isCompanyJob = companyName !== "";

    if (!foremanMap[foremanName]) {
      foremanMap[foremanName] = {
        daily: 0,
        monthly: 0,
        carsToday: 0,
        carsMonth: 0,
      };
    }

    // Zeena, Perfume, Wiper
    const specialServices = ["Zeena", "Perfume", "Wipers"];
    if (specialServices.includes(service)) {
      if (!zeenahMap[service])
        zeenahMap[service] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      if (isToday) {
        zeenahMap[service].dailyCars++;
        zeenahMap[service].dailyAmt += serviceAmt;
      }
      if (isThisMonth) {
        zeenahMap[service].monthlyCars++;
        zeenahMap[service].monthlyAmt += serviceAmt;
      }
    }

    // Company
    if (isCompanyJob) {
      if (!companyMap[companyName]) {
        companyMap[companyName] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      }
      if (isToday) {
        companyMap[companyName].dailyAmt += actualAmt;
        companyMap[companyName].dailyCars++;
      }
      if (isThisMonth) {
        companyMap[companyName].monthlyAmt += actualAmt;
        companyMap[companyName].monthlyCars++;
      }
    }

    // Oil
    if (oilChange && oilChange.toString().trim() !== "") {
      if (!oilMap[oilChange])
        oilMap[oilChange] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      if (isToday) {
        oilMap[oilChange].dailyAmt += serviceAmt;
        oilMap[oilChange].dailyCars++;
      }
      if (isThisMonth) {
        oilMap[oilChange].monthlyAmt += serviceAmt;
        oilMap[oilChange].monthlyCars++;
      }
    }

    // Employee (include all)
    const splitAmt = serviceAmt / empNames.length;
    empNames.forEach((name) => {
      if (!empMap[name])
        empMap[name] = { daily: 0, monthly: 0, carsToday: 0, carsMonth: 0 };

      if (isToday) {
        empMap[name].daily += splitAmt;
        empMap[name].carsToday++;

        // Track last job timestamp today
        if (!empLastWorkToday[name] || date > empLastWorkToday[name]) {
          empLastWorkToday[name] = date;
        }
      }

      if (isThisMonth) {
        empMap[name].monthly += splitAmt;
        empMap[name].carsMonth++;
      }
    });

    // Foreman (exclude company)
    if (!isCompanyJob) {
      if (isToday) {
        foremanMap[foremanName].daily += serviceAmt;
        foremanMap[foremanName].carsToday++;
      }
      if (isThisMonth) {
        foremanMap[foremanName].monthly += serviceAmt;
        foremanMap[foremanName].carsMonth++;
      }
    }

    // Totals

    if (isToday) {
      if (isCompanyJob) {
        carsTodayIncl++;
        totalTodayIncl += actualAmt;
      } else {
        carsTodayIncl++;
        carsTodayExcl++;
        totalTodayIncl += actualAmt;
        totalTodayExcl += actualAmt;
      }
    }

    if (isThisMonth) {
      if (isCompanyJob) {
        carsMonthIncl++;
        totalMonthIncl += actualAmt;
      } else {
        carsMonthIncl++;
        carsMonthExcl++;
        totalMonthIncl += actualAmt;
        totalMonthExcl += actualAmt;
      }
    }
  }

  // Clear output
  clearReportRenderArea(sheet);

  const formatMoney = (amt) => `AED ${amt.toLocaleString("en-US")}`;
  let currentRow = 2;

  // HEADER
  sheet
    .getRange(currentRow, 13, 1, 5)
    .merge()
    .setValue("AL RAKED EARNINGS REPORT")
    .setFontWeight("bold")
    .setFontSize(REPORT_FONT_SIZE.TITLE)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setHorizontalAlignment("center");
  currentRow++;
  sheet
    .getRange(currentRow, 13, 1, 5)
    .merge()
    .setValue(
      "Last Updated: " +
        Utilities.formatDate(
          new Date(),
          Session.getScriptTimeZone(),
          "dd MMM yyyy HH:mm:ss",
        ),
    )
    .setFontSize(REPORT_FONT_SIZE.TIMESTAMP)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setHorizontalAlignment("center");
  currentRow += 2;

  // SUMMARY HEADING
  sheet
    .getRange(currentRow, 13, 1, 5)
    .merge()
    .setValue("DAILY & MONTHLY SUMMARY")
    .setFontWeight("bold")
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_TITLE)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setHorizontalAlignment("center");
  currentRow++;

  // Subheadings for two distinct tables
  sheet
    .getRange(currentRow, 13, 1, 2)
    .merge()
    .setValue("WITHOUT COMPANY")
    .setFontWeight("bold")
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TABLE_HEADER)
    .setHorizontalAlignment("center");
  sheet
    .getRange(currentRow, 16, 1, 2)
    .merge()
    .setValue("WITH COMPANY")
    .setFontWeight("bold")
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TABLE_HEADER)
    .setHorizontalAlignment("center");
  currentRow++;

  const summaryDataExcl = [
    ["Earnings Today", formatMoney(totalTodayExcl)],
    ["Cars Washed Today", carsTodayExcl],
    ["Monthly Earnings", formatMoney(totalMonthExcl)],
    ["Cars Washed this Month", carsMonthExcl],
  ];
  const summaryDataIncl = [
    ["Earnings Today", formatMoney(totalTodayIncl)],
    ["Cars Washed Today", carsTodayIncl],
    ["Monthly Earnings", formatMoney(totalMonthIncl)],
    ["Cars Washed this Month", carsMonthIncl],
  ];

  // Left table
  const exclRange = sheet.getRange(currentRow, 13, summaryDataExcl.length, 2);
  exclRange.setValues(summaryDataExcl).setFontFamily(REPORT_FONT_FAMILY);
  exclRange.setBorder(true, true, true, true, true, true);
  exclRange.setHorizontalAlignment("right");
  sheet
    .getRange(currentRow, 13, summaryDataExcl.length, 1)
    .setFontWeight("bold")
    .setHorizontalAlignment("left")
    .setWrap(true)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_LABEL);

  // Right table
  const inclRange = sheet.getRange(currentRow, 16, summaryDataIncl.length, 2);
  inclRange.setValues(summaryDataIncl).setFontFamily(REPORT_FONT_FAMILY);
  inclRange.setBorder(true, true, true, true, true, true);
  inclRange.setHorizontalAlignment("right");
  sheet
    .getRange(currentRow, 16, summaryDataIncl.length, 1)
    .setFontWeight("bold")
    .setHorizontalAlignment("left")
    .setWrap(true)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_LABEL);

  // FORMAT SUMMARY VALUES

  sheet
    .getRange(currentRow, 14, summaryDataExcl.length, 1)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_VALUE)
    .setFontWeight("bold")
    .setHorizontalAlignment("right");

  sheet
    .getRange(currentRow, 17, summaryDataIncl.length, 1)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_VALUE)
    .setFontWeight("bold")
    .setHorizontalAlignment("right");

  currentRow += summaryDataExcl.length + 2;

  // Generic table function
  function writeTable(title, headers, rows, leftAlignCols = [0]) {
    sheet
      .getRange(currentRow, 13, 1, headers.length)
      .merge()
      .setValue(title)
      .setFontWeight("bold")
      .setFontSize(REPORT_FONT_SIZE.SECTION_TITLE)
      .setFontFamily(REPORT_FONT_FAMILY)
      .setHorizontalAlignment("center");
    currentRow++;
    sheet
      .getRange(currentRow, 13, 1, headers.length)
      .setValues([headers])
      .setFontWeight("bold")
      .setFontFamily(REPORT_FONT_FAMILY)
      .setFontSize(REPORT_FONT_SIZE.TABLE_HEADER);
    currentRow++;
    if (rows.length) {
      const range = sheet.getRange(currentRow, 13, rows.length, headers.length);

      range
        .setValues(rows)
        .setFontFamily(REPORT_FONT_FAMILY)
        .setFontSize(REPORT_FONT_SIZE.TABLE_BODY)
        .setWrap(true);

      range.setBorder(true, true, true, true, true, true);

      // Alignment
      range.setHorizontalAlignment("right");
      leftAlignCols.forEach((c) => {
        const range = sheet.getRange(currentRow, 13 + c, rows.length, 1);
        range.setHorizontalAlignment("left");
        range.setFontWeight("bold");
      });

      currentRow += rows.length + 2;
