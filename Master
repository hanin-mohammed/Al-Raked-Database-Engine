    .addToUi();
}

function emailPerformanceReport() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Form Responses 1");

  // 1. Generate latest report
  calc();

  // 2. Format the date for subject and file name
  const today = new Date();
  const timeZone = Session.getScriptTimeZone();
  
  // Full month name for both
  const subjectDate = Utilities.formatDate(today, timeZone, "MMMM d, yyyy"); // e.g., August 3, 2025
  const fileDate = Utilities.formatDate(today, timeZone, "MMMM d yyyy")      // e.g., August 3 2025
    .replace(/ /g, "_"); // Convert spaces to underscores for file name

  // 3. Create PDF export link for the active sheet
  const url = `https://docs.google.com/spreadsheets/d/${ss.getId()}/export?format=pdf&` +
    `size=A4&portrait=true&fitw=true&sheetnames=false&printtitle=false` +
    `&pagenumbers=false&gridlines=false&fzr=false&gid=${sheet.getSheetId()}`;

  const options = {
    headers: { Authorization: "Bearer " + ScriptApp.getOAuthToken() }
  };

  // 4. Fetch PDF file
  const response = UrlFetchApp.fetch(url, options);
  const blob = response.getBlob().setName(
    `${fileDate}_Al_Raked_Performance_Report.pdf`
  );

  // 5. Email the PDF
  MailApp.sendEmail({
    to: "alrakedcarwashingstation@gmail.com",
    subject: `${subjectDate} - Al Raked Performance Report`,
    body: "Attached is the daily performance report for today.",
    attachments: [blob]
  });
}

function createTriggers() {
  // Delete all existing triggers for calc and emailPerformanceReport to avoid duplicates
  const triggers = ScriptApp.getProjectTriggers();
  for (const t of triggers) {
    const funcName = t.getHandlerFunction();
    if (funcName === "calc" || funcName === "emailPerformanceReport") {
      ScriptApp.deleteTrigger(t);
    }
  }


  // Run calc() at 11:30 PM daily (final update before email)
  ScriptApp.newTrigger("calc")
    .timeBased()
    .atHour(23)
    .nearMinute(30)
    .everyDays(1)
    .create();

  // Send email report at 11:45 PM daily
  ScriptApp.newTrigger("emailPerformanceReport")
    .timeBased()
    .atHour(23)
    .nearMinute(45)
    .everyDays(1)
    .create();
}

function onFormSubmit(e) {
  // 1. Process the new response (sorting, unmerging, etc.)
  processFormSubmission();

  // 2. Wait 10 seconds for Google Sheets to finish updating
  Utilities.sleep(10000);

  // 3. Update the performance report
  calc();
}

//Duplicating sheet once a month

function duplicateSheetAtMonthEnd() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sourceSheet = ss.getSheetByName("Form Responses 1");
  if (!sourceSheet) return;

  const now = new Date();
  const year = now.getFullYear();
  const month = now.getMonth();

  // Check if today is the last day of the month
  const tomorrow = new Date(year, month, now.getDate() + 1);
  if (tomorrow.getMonth() !== month) {
    // Today is last day of month
    const monthName = Utilities.formatDate(
      now,
      Session.getScriptTimeZone(),
      "MMMM yyyy"
    );

    const newName = `Form Responses 1 - ${monthName}`;

    // Avoid duplicate copies if script runs again
    if (ss.getSheetByName(newName)) return;

    sourceSheet.copyTo(ss).setName(newName);
  }
}

function createMonthEndTrigger() {
  // Remove existing trigger if present
  const triggers = ScriptApp.getProjectTriggers();
  for (const t of triggers) {
    if (t.getHandlerFunction() === "duplicateSheetAtMonthEnd") {
      ScriptApp.deleteTrigger(t);
    }
  }

  // Run every day at 11:45 PM
  ScriptApp.newTrigger("duplicateSheetAtMonthEnd")
    .timeBased()
    .atHour(23)
    .nearMinute(45)
    .everyDays(1)
    .create();
}
