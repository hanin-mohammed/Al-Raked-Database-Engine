function createMonthlyMainPdfStage(state, referenceDate) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Form Responses 1");
  const tz = Session.getScriptTimeZone();
  const monthName = Utilities.formatDate(referenceDate, tz, "MMMM yyyy");
  const fileDate = Utilities.formatDate(referenceDate, tz, "MMMM_yyyy");
  const reportSheetName = "TEMP_MONTHLY_REPORT";
  const existingReport = ss.getSheetByName(reportSheetName);
  const legacyLog = ss.getSheetByName("TEMP_PRIVATE_LOG");
  if (existingReport) ss.deleteSheet(existingReport);
  if (legacyLog) ss.deleteSheet(legacyLog);

  const tempReport = ss.insertSheet(reportSheetName);

  try {
    const reportLastRow = getLastReportRow(sheet);
    if (tempReport.getMaxRows() < reportLastRow) {
      tempReport.insertRowsAfter(
        tempReport.getMaxRows(),
        reportLastRow - tempReport.getMaxRows(),
      );
    }

    sheet
      .getRange(1, REPORT_START_COLUMN, reportLastRow, REPORT_COLUMN_COUNT)
      .copyTo(tempReport.getRange("A1"), { contentsOnly: false });
    tempReport.setColumnWidths(1, 6, 140);
    tempReport.setColumnWidth(1, 260);
    tempReport.getRange(1, 1, reportLastRow, 6).setWrap(true);
    tempReport.setFrozenRows(2);
    tempReport.getRange("A2").setValue(`AL RAKED EARNINGS REPORT ${monthName}`);

    const reportValues = tempReport.getDataRange().getValues();
    for (let i = 0; i < reportValues.length; i++) {
      const title = (reportValues[i][0] || "").toString().trim();
      if (title.endsWith(" VEHICLE LOG")) {
        tempReport.deleteRows(i + 1, reportValues.length - i);
        break;
      }
    }

    SpreadsheetApp.flush();
    const pdfUrl =
      `https://docs.google.com/spreadsheets/d/${ss.getId()}/export?format=pdf` +
      `&size=A4&portrait=true&fitw=true&sheetnames=false&printtitle=false` +
      `&pagenumbers=false&gridlines=false&fzr=false&gid=${tempReport.getSheetId()}`;
    const response = UrlFetchApp.fetch(pdfUrl, reportPipelineFetchOptions());

    if (response.getResponseCode() !== 200) {
      throw new Error("Monthly earnings PDF export failed.");
    }

    state.monthlyPdfFileName = `Al_Raked_Earnings_Report_${fileDate}.pdf`;
    const file = getReportPipelineTempFolder().createFile(
      response.getBlob().setName(state.monthlyPdfFileName),
    );
    state.monthlyPdfFileId = rememberReportPipelineFile(state, file);

    const companyLogs = getMonthlyCompanyLogs(referenceDate);
    state.companyNames = Object.keys(companyLogs).sort((a, b) =>
      a.localeCompare(b),
    );
    state.companyIndex = 0;
    state.companyFiles = [];
    state.stage = state.companyNames.length
      ? "MONTHLY_COMPANY_FILE"
      : "MONTHLY_SEND";
    state.attempts = 0;
    saveReportPipelineState(state);
  } finally {
    const reportTab = ss.getSheetByName(reportSheetName);
    if (reportTab) ss.deleteSheet(reportTab);
  }
}

function createMonthlyCompanyFileStage(state, referenceDate) {
  cleanupInterruptedCompanySpreadsheet(state);

  if (state.companyIndex >= state.companyNames.length) {
    state.stage = "MONTHLY_SEND";
    saveReportPipelineState(state);
    return;
  }

  const companyName = state.companyNames[state.companyIndex];
  const companyLogs = getMonthlyCompanyLogs(referenceDate);
  const rows = companyLogs[companyName];

  if (!rows) {
    throw new Error(`Company data disappeared before export: ${companyName}`);
  }

  const safeCompanyName = safeFilePart(companyName);
  const fileDate = Utilities.formatDate(
    referenceDate,
    Session.getScriptTimeZone(),
    "MMMM_yyyy",
  );
  const tempSpreadsheet = SpreadsheetApp.create(
    `TEMP_${safeCompanyName}_LOG_EXPORT`,
  );
  state.activeTempSpreadsheetId = tempSpreadsheet.getId();
  saveReportPipelineState(state);

  try {
    const exportSheet = tempSpreadsheet.getSheets()[0];
    exportSheet.setName("Company Log");
    formatCompanyExportSheet(exportSheet, rows);
    SpreadsheetApp.flush();

    const xlsxUrl =
      `https://docs.google.com/spreadsheets/d/${tempSpreadsheet.getId()}` +
      "/export?format=xlsx";
    const response = UrlFetchApp.fetch(
      xlsxUrl,
      reportPipelineFetchOptions(),
    );

    if (response.getResponseCode() !== 200) {
      throw new Error(`Excel export failed for ${companyName}.`);
    }

    const fileName = `${safeCompanyName}_Log_${fileDate}.xlsx`;
    const file = getReportPipelineTempFolder().createFile(
      response.getBlob().setName(fileName),
    );
    const fileId = rememberReportPipelineFile(state, file);
    state.companyFiles.push({
      companyName: companyName,
      fileName: fileName,
      fileId: fileId,
    });
    state.companyIndex++;
    state.stage =
      state.companyIndex < state.companyNames.length
        ? "MONTHLY_COMPANY_FILE"
        : "MONTHLY_SEND";
    state.attempts = 0;
    saveReportPipelineState(state);
  } finally {
    trashReportPipelineFile(tempSpreadsheet.getId());
    state.activeTempSpreadsheetId = "";
    saveReportPipelineState(state);
  }
}

