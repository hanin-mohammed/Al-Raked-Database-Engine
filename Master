function getArchiveMonthDetails(sheetName) {
  const archiveMatch = /^(Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\s*'(\d{2})$/i.exec(
    (sheetName || "").toString().trim(),
  );

  if (!archiveMatch) return null;

  const shortMonths = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ];
  const fullMonths = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ];
  const shortMonth = archiveMatch[1].slice(0, 3).toLowerCase();
  const monthIndex = shortMonths.findIndex(
    (month) => month.toLowerCase() === shortMonth,
  );
  const fullYear = `20${archiveMatch[2]}`;

  if (monthIndex < 0) return null;

  const monthKey = `${fullYear}-${String(monthIndex + 1).padStart(2, "0")}`;
  if (monthKey < EMPLOYEE_ARCHIVE_START_KEY) return null;

  return {
    monthKey,
    monthLabel: `${fullMonths[monthIndex]} ${fullYear}`,
  };
}

function getEmployeesFromSheet(sheet, monthKey) {
  if (!sheet) return [];

  const lastRow = getFormResponseLastRow(sheet);
  if (lastRow < 2) return [];

  const tz = Session.getScriptTimeZone();
  const employees = {};
  const rows = sheet.getRange(2, 1, lastRow - 1, 3).getValues();

  rows.forEach((row) => {
    if (monthKey) {
      const timestamp = row[0] instanceof Date ? row[0] : new Date(row[0]);
      if (isNaN(timestamp.getTime())) return;
      if (Utilities.formatDate(timestamp, tz, "yyyy-MM") !== monthKey) return;
    }

    (row[2] || "")
      .toString()
      .split(/,|\s+/)
      .map((name) => name.trim().toUpperCase())
      .filter(Boolean)
      .forEach((name) => {
        employees[name] = true;
      });
  });

  return Object.keys(employees).sort();
}

function ensureEmployeeMonthIndexSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(EMPLOYEE_MONTH_INDEX_SHEET);

  if (!sheet) {
    sheet = ss.insertSheet(EMPLOYEE_MONTH_INDEX_SHEET);
    sheet
      .getRange(1, 1, 1, 4)
      .setValues([["Employee", "MonthKey", "MonthLabel", "UpdatedAt"]]);
  }

  if (!sheet.isSheetHidden()) sheet.hideSheet();
  return sheet;
}

function writeEmployeeMonthIndexRows(indexSheet, rows) {
  const existingLastRow = indexSheet.getLastRow();
  if (existingLastRow > 1) {
    indexSheet.getRange(2, 1, existingLastRow - 1, 4).clearContent();
  }

  if (rows.length) {
    rows.sort(
      (a, b) =>
        String(b[1]).localeCompare(String(a[1])) ||
        String(a[0]).localeCompare(String(b[0])),
    );
    indexSheet.getRange(2, 1, rows.length, 4).setValues(rows);
  }

  if (!indexSheet.isSheetHidden()) indexSheet.hideSheet();
}

function replaceEmployeeMonthIndexMonth(monthKey, monthLabelText, employees) {
  const indexSheet = ensureEmployeeMonthIndexSheet();
  const lastRow = indexSheet.getLastRow();
  const existingRows = lastRow > 1
    ? indexSheet.getRange(2, 1, lastRow - 1, 4).getValues()
    : [];
  const updatedAt = new Date();
  const rows = existingRows
    .filter((row) => String(row[1]) !== monthKey)
    .concat(
      employees.map((employee) => [
        employee,
        monthKey,
        monthLabelText,
        updatedAt,
      ]),
    );

  writeEmployeeMonthIndexRows(indexSheet, rows);
}

function refreshEmployeeMonthIndexFromArchive(sheet) {
  const details = sheet ? getArchiveMonthDetails(sheet.getName()) : null;
  if (!details) return;

  replaceEmployeeMonthIndexMonth(
    details.monthKey,
    details.monthLabel,
    getEmployeesFromSheet(sheet, details.monthKey),
  );
}

function rebuildEmployeeMonthIndex() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const indexSheet = ensureEmployeeMonthIndexSheet();
  const updatedAt = new Date();
  const rows = [];

  ss.getSheets().forEach((sheet) => {
    const details = getArchiveMonthDetails(sheet.getName());
    if (!details) return;

    getEmployeesFromSheet(sheet, details.monthKey).forEach((employee) => {
      rows.push([employee, details.monthKey, details.monthLabel, updatedAt]);
    });
  });

  writeEmployeeMonthIndexRows(indexSheet, rows);
  return indexSheet;
}

function getEmployeeMonthIndexSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(EMPLOYEE_MONTH_INDEX_SHEET);
  return sheet && sheet.getLastRow() > 1 ? sheet : rebuildEmployeeMonthIndex();
}

function preserveClosingMonthEmployeeIndex(sourceSheet, today, tz) {
  const closingMonth = new Date(today.getFullYear(), today.getMonth() - 1, 1);
  const monthKey = Utilities.formatDate(closingMonth, tz, "yyyy-MM");
  const monthLabelText = Utilities.formatDate(closingMonth, tz, "MMMM yyyy");
  const employees = getEmployeesFromSheet(sourceSheet, monthKey);

  if (!SpreadsheetApp.getActiveSpreadsheet().getSheetByName(EMPLOYEE_MONTH_INDEX_SHEET)) {
    rebuildEmployeeMonthIndex();
  }

  if (!employees.length) {
    Logger.log("Employee month index kept unchanged: no closing-month rows found.");
    return;
  }

  replaceEmployeeMonthIndexMonth(monthKey, monthLabelText, employees);
}

