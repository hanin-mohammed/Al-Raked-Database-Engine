    const mainResponse = UrlFetchApp.fetch(exportUrl, options);

    if (mainResponse.getResponseCode() !== 200) {
      throw new Error("Main PDF export failed.");
    }

    const mainPdf = mainResponse
      .getBlob()
      .setName(`${fileDate}_Al_Raked_Performance_Report.pdf`);

    let attachments = [mainPdf];

    const auditData = auditSheet.getDataRange().getValues();

    const rowsToday = [];

    for (let i = 1; i < auditData.length; i++) {
      const changeTime = new Date(auditData[i][0]);

      if (changeTime.toDateString() === today.toDateString()) {
        rowsToday.push(auditData[i].slice(0, 10));
      }
    }

    let auditText = "No price changes recorded today.";

    if (rowsToday.length > 0) {
      const tempName = "TEMP_AUDIT_EXPORT";

      const existing = ss.getSheetByName(tempName);

