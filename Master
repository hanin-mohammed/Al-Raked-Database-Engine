// Run on each new form submission
function assignImageToNewEntry() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1");
  const lastRow = sheet.getLastRow();

  if (lastRow < 2) return; // no data
  const name = sheet.getRange(lastRow, 3).getValue().toString().trim().toUpperCase(); // column C = employee
  const cell = sheet.getRange(lastRow, 9); // column I

  if (employeeImageMap[name]) {
    const formula = `=IMAGE("${employeeImageMap[name]}")`;
    cell.setFormula(formula);
  } else {
    cell.clearContent();
  }
}

// Run daily at 11 PM to clear today's images
function clearTodayImages() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1");
  const data = sheet.getDataRange().getValues();
  const todayStr = new Date().toDateString();

  for (let i = 1; i < data.length; i++) {
    const timestamp = data[i][0];
    if (!timestamp) continue;
    const rowDate = new Date(timestamp);
    if (rowDate.toDateString() === todayStr) {
      sheet.getRange(i + 1, 9).clearContent(); // remove image in column I
    }
  }
}

