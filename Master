function searchVehicleHistory(plate) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sheets = ss.getSheets();

  const normalizedSearch = normalizePlate(plate);

  const results = [];

  sheets.forEach((sheet) => {
    const name = sheet.getName();

    // Skip non-data sheets
    if (name === "PriceAudit" || name.startsWith("TEMP")) {
      return;
    }

    const data = getDataSheetValues(sheet);

    for (let i = 1; i < data.length; i++) {
      const row = data[i];

      const plateValue = normalizePlate(row[3]);

      if (plateValue === normalizedSearch) {
        results.push({
          sheet: name,
          timestamp: row[0],
          foreman: row[1],
          employee: row[2],
          plate: row[3],
          service: row[4],
          price:
            row[9] !== "" && row[9] !== null && row[9] !== undefined
              ? row[9]
              : row[5],
          company: row[6],
          oil: row[7],
        });
      }
    }
  });

  results.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

  return results.slice(0, 15);
}

function normalizePlate(text) {
  return (text || "")
    .toString()
    .toUpperCase()
    .replace(/\s+/g, "")
    .replace(/-/g, "");
}

function doGet(e) {
  const key = e.parameter.key;

  const search = e.parameter.search;
  const yesterday = e.parameter.yesterday;

  const employeeList = e.parameter.employeeList;
  const employeeMonths = e.parameter.employeeMonths;
  const employeePerformance = e.parameter.employeePerformance;
  const month = e.parameter.month;
  const trend = e.parameter.trend;

  if (key !== "013187") {
    return ContentService.createTextOutput("Unauthorized").setMimeType(
      ContentService.MimeType.TEXT,
    );
  }

  if (yesterday) {
    return ContentService.createTextOutput(getYesterdaySnapshot()).setMimeType(
      ContentService.MimeType.JSON,
    );
  }

  if (employeeList) {
    return ContentService.createTextOutput(
      JSON.stringify(getAllEmployeesList()),
    ).setMimeType(ContentService.MimeType.JSON);
  }

  if (employeeMonths) {
    return ContentService.createTextOutput(
      JSON.stringify(getEmployeeMonths(employeeMonths)),
    ).setMimeType(ContentService.MimeType.JSON);
  }

  if (employeePerformance && month) {
    return ContentService.createTextOutput(
      JSON.stringify(getEmployeeMonthlyPerformance(employeePerformance, month)),
    ).setMimeType(ContentService.MimeType.JSON);
  }

  if (trend) {
    return ContentService.createTextOutput(
      JSON.stringify(getMonthlyTrendData(month)),
    ).setMimeType(ContentService.MimeType.JSON);
  }

  if (search) {
    const results = searchVehicleHistory(search);

    return ContentService.createTextOutput(JSON.stringify(results))

      .setMimeType(ContentService.MimeType.JSON);
  }

  const cache = PropertiesService.getScriptProperties()

    .getProperty("TELEGRAM_REPORT_CACHE");

  return ContentService.createTextOutput(cache || "{}").setMimeType(
    ContentService.MimeType.JSON,
  );
}

