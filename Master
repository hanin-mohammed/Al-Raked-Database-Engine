function createTriggers() {
  // Remove only managed triggers so rerunning setup cannot create duplicates.
  const triggers = ScriptApp.getProjectTriggers();
  for (const t of triggers) {
    const funcName = t.getHandlerFunction();
    if (
      funcName === "onFormSubmit" ||
      funcName === "auditPriceChange" ||
      funcName === "handleFormResponseEdit" ||
      funcName === "handleFormResponseChange" ||
      funcName === "handleFirebaseLiveDisplayStatusEdit" ||
      funcName === "handleFirebaseLiveDisplayEdit" ||
      funcName === "handleFirebaseLiveDisplayChange" ||
      funcName === "reconcileFirebaseLiveDisplayStatuses" ||
      funcName === "cleanSlateProtocol" ||
      funcName === "calc" ||
      funcName === "emailPerformanceReport" ||
      funcName === "emailMonthlyReport" ||
      funcName === "saveYesterdaySnapshot" ||
      funcName === "saveDailyGraphSnapshot" ||
      funcName === "duplicateSheetAtMonthEnd" ||
      funcName === "runNightlyOperations" ||
      funcName === "sendNightlyPerformanceEmail" ||
      funcName === "runReportPipelineWorker" ||
      funcName === "runReportPipelineWatchdog" ||
      funcName === "refreshReportTimestamp" ||
      funcName === "runMonthlyCleanSlateCheck" ||
      funcName === "runDeferredCleanSlate" ||
      funcName === "deleteAccidentalNumberedSheets"
    ) {
      ScriptApp.deleteTrigger(t);
    }
  }

  ScriptApp.newTrigger("onFormSubmit")
    .forSpreadsheet(SpreadsheetApp.getActive())
    .onFormSubmit()
    .create();

  ScriptApp.newTrigger("handleFormResponseEdit")
    .forSpreadsheet(SpreadsheetApp.getActive())
    .onEdit()
    .create();

  ScriptApp.newTrigger("handleFormResponseChange")
    .forSpreadsheet(SpreadsheetApp.getActive())
    .onChange()
    .create();

  ScriptApp.newTrigger("reconcileFirebaseLiveDisplayStatuses")
    .timeBased()
    .everyMinutes(1)
    .create();

  ScriptApp.newTrigger("runMonthlyCleanSlateCheck")
    .timeBased()
    .onMonthDay(1)
    .atHour(2)
    .create();

  // One trigger runs every night operation in a fixed sequence. The +/-15
  // minute window remains safely before midnight.
  ScriptApp.newTrigger("runNightlyOperations")
    .timeBased()
    .atHour(23)
    .nearMinute(30)
    .everyDays(1)
    .create();

  // Resumes an interrupted report stage after an Apps Script hard timeout.
  ScriptApp.newTrigger("runReportPipelineWatchdog")
    .timeBased()
    .everyMinutes(10)
    .create();

  // Remove only automatically named sheets such as Sheet12 or Sheet123.
  ScriptApp.newTrigger("deleteAccidentalNumberedSheets")
    .timeBased()
    .atHour(4)
    .nearMinute(0)
    .everyDays(1)
    .create();
}

function scheduleNightlyPerformanceEmail(delayMinutes) {
  scheduleReportPipelineWorker(delayMinutes);
}

function scheduleReportPipelineWorker(delayMinutes) {
  const handler = "runReportPipelineWorker";

  ScriptApp.getProjectTriggers().forEach((trigger) => {
    if (trigger.getHandlerFunction() === handler) {
      ScriptApp.deleteTrigger(trigger);
    }
  });

  ScriptApp.newTrigger(handler)
    .timeBased()
    .after(Math.max(1, Number(delayMinutes) || 1) * 60 * 1000)
    .create();
}

function sendNightlyPerformanceEmail() {
  runReportPipelineWorker();
}

function runNightlyOperations() {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    calc();
    saveDailyGraphSnapshot();
    saveYesterdaySnapshot();
  } finally {
    lock.releaseLock();
  }

  const now = new Date();
  const tomorrow = new Date(
    now.getFullYear(),
    now.getMonth(),
    now.getDate() + 1,
  );
  const isMonthEnd = tomorrow.getMonth() !== now.getMonth();

  if (isMonthEnd) {
    // Protect the raw month before any export work begins.
    duplicateSheetAtMonthEnd();
  }

  initializeReportPipeline(now, isMonthEnd);
  scheduleReportPipelineWorker(1);
}

function getReportPipelineState() {
  const value = PropertiesService.getScriptProperties().getProperty(
    REPORT_PIPELINE_STATE_PROPERTY,
  );

  if (!value) return null;

  try {
    return JSON.parse(value);
  } catch (err) {
    throw new Error("Stored report pipeline state is invalid: " + err);
  }
}

function saveReportPipelineState(state) {
  PropertiesService.getScriptProperties().setProperty(
    REPORT_PIPELINE_STATE_PROPERTY,
    JSON.stringify(state),
  );
}

function clearReportPipelineState() {
  PropertiesService.getScriptProperties().deleteProperty(
    REPORT_PIPELINE_STATE_PROPERTY,
  );
}

function reportPipelineDateKey(date) {
  return Utilities.formatDate(
    date,
    Session.getScriptTimeZone(),
    "yyyy-MM-dd",
  );
}

function reportPipelineMonthKey(date) {
  return Utilities.formatDate(
    date,
    Session.getScriptTimeZone(),
    "yyyy-MM",
  );
}

function getReportPipelineArchiveName(date) {
  const tz = Session.getScriptTimeZone();
  return (
    Utilities.formatDate(date, tz, "MMM") +
    "'" +
    Utilities.formatDate(date, tz, "yy")
  );
}

function initializeReportPipeline(referenceDate, isMonthEnd) {
  const existing = getReportPipelineState();
  const dateKey = reportPipelineDateKey(referenceDate);

  if (existing) {
    if (existing.dateKey === dateKey) return;

    throw new Error(
      `The report pipeline for ${existing.dateKey} is still incomplete. ` +
        "It was preserved instead of being overwritten.",
    );
  }

  const monthKey = reportPipelineMonthKey(referenceDate);
  const state = {
    version: 3,
    dateKey: dateKey,
    monthKey: monthKey,
    referenceIso: referenceDate.toISOString(),
    isMonthEnd: Boolean(isMonthEnd),
    stage: "DAILY_MAIN_PDF",
    attempts: 0,
    dailyMainFileId: "",
    dailyAuditFileId: "",
    dailyAuditText: "No price changes recorded today.",
    monthlyPdfFileId: "",
    monthlyPdfFileName: "",
    companyNames: [],
    companyIndex: 0,
    companyFiles: [],
    activeTempSpreadsheetId: "",
    cleanupFileIds: [],
  };

  saveReportPipelineState(state);

  if (isMonthEnd) {
    PropertiesService.getScriptProperties().setProperty(
      REPORT_PIPELINE_ACTIVE_PREFIX + monthKey,
      "YES",
    );
  }
}

function reportPipelineFetchOptions() {
  return {
    headers: { Authorization: "Bearer " + ScriptApp.getOAuthToken() },
    muteHttpExceptions: true,
  };
}

function getReportPipelineTempFolder() {
  const properties = PropertiesService.getScriptProperties();
  const storedId = properties.getProperty(
    REPORT_PIPELINE_TEMP_FOLDER_PROPERTY,
  );

  if (storedId) {
    try {
      return DriveApp.getFolderById(storedId);
    } catch (err) {
      Logger.log("Stored temporary folder was unavailable: " + err);
    }
  }

  const matchingFolders = DriveApp.getFoldersByName(
    REPORT_PIPELINE_TEMP_FOLDER_NAME,
  );
  const folder = matchingFolders.hasNext()
    ? matchingFolders.next()
    : DriveApp.createFolder(REPORT_PIPELINE_TEMP_FOLDER_NAME);

  properties.setProperty(REPORT_PIPELINE_TEMP_FOLDER_PROPERTY, folder.getId());
  return folder;
}

function rememberReportPipelineFile(state, file) {
  state.cleanupFileIds = state.cleanupFileIds || [];
  if (!state.cleanupFileIds.includes(file.getId())) {
    state.cleanupFileIds.push(file.getId());
  }
  saveReportPipelineState(state);
  return file.getId();
}

function trashReportPipelineFile(fileId) {
  if (!fileId) return;

  try {
    DriveApp.getFileById(fileId).setTrashed(true);
  } catch (err) {
    Logger.log(`Temporary file cleanup failed for ${fileId}: ${err}`);
  }
}

function cleanupUntrackedReportPipelineFiles(state) {
  const keepIds = new Set((state && state.cleanupFileIds) || []);
  const files = getReportPipelineTempFolder().getFiles();

  while (files.hasNext()) {
    const file = files.next();
    if (!keepIds.has(file.getId())) file.setTrashed(true);
  }
}

function cleanupInterruptedCompanySpreadsheet(state) {
  if (!state.activeTempSpreadsheetId) return;

  trashReportPipelineFile(state.activeTempSpreadsheetId);
  state.activeTempSpreadsheetId = "";
  saveReportPipelineState(state);
}

