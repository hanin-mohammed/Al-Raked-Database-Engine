  const foremanMap = {};
  const companyMap = {};
  const oilMap = {};
  let enterpriseJobs = [];

  let totalTodayIncl = 0,
    totalMonthIncl = 0;
  let totalTodayExcl = 0,
    totalMonthExcl = 0;
  let carsTodayIncl = 0,
    carsMonthIncl = 0;
  let carsTodayExcl = 0,
    carsMonthExcl = 0;

  const month = now.getMonth();
  const year = now.getFullYear();

  for (let i = 1; i < data.length; i++) {
    const [
      timestamp,
      foreman,
      employee,
      licensePlate,
      service,
      serviceFee,
      company,
      oilChange,
      companyDetail,
      specialPrice,
    ] = data[i];
    if (!timestamp) continue;

    const date = new Date(timestamp);

    const isExtended = date >= start && date <= end;
    const isThisMonth =
      date.getMonth() === month && date.getFullYear() === year;

    let serviceAmt = 0;
    if (serviceFee && serviceFee.toString().toLowerCase() !== "free") {
      serviceAmt = parseFloat(serviceFee) || 0;
    }

    let actualAmt =
      specialPrice !== "" && specialPrice != null
        ? parseFloat(specialPrice) || 0
        : serviceAmt;

    const empNames = (employee || "")
      .toString()
      .split(/,|\s+/) // split by comma OR any space(s)
      .map((e) => e.trim())
      .filter((e) => e !== "");
    const foremanName = (foreman || "").toString().trim();

    if (!empNames.length || !foremanName) continue;

    const isCompanyJob = company && company.toString().trim() !== "";

    // -------- ENTERPRISE --------
    if (
      (companyDetail && companyDetail.toString().trim() !== "") ||
      (company && company.toString().trim() === "Private Office")
    ) {
      enterpriseJobs.push([
        timestamp,
        foreman,
        employee,
        licensePlate,
        service,
        actualAmt,
        company,
        oilChange,
        companyDetail,
      ]);
    }

    // -------- INIT --------
    if (!foremanMap[foremanName]) {
      foremanMap[foremanName] = {
        daily: 0,
        monthly: 0,
        carsToday: 0,
        carsMonth: 0,
      };
    }

    // -------- SPECIAL SERVICES --------
    const specialServices = ["Zeena", "Perfume", "Wipers"];
    if (specialServices.includes(service)) {
      if (!zeenahMap[service])
        zeenahMap[service] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };

      if (isExtended) {
        zeenahMap[service].dailyCars++;
        zeenahMap[service].dailyAmt += serviceAmt;
      }
      if (isThisMonth) {
        zeenahMap[service].monthlyCars++;
        zeenahMap[service].monthlyAmt += serviceAmt;
      }
    }

    // -------- COMPANY --------
    if (isCompanyJob) {
      if (!companyMap[company]) {
        companyMap[company] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      }

      if (isExtended) {
        companyMap[company].dailyAmt += serviceAmt;
        companyMap[company].dailyCars++;
      }
      if (isThisMonth) {
        companyMap[company].monthlyAmt += serviceAmt;
        companyMap[company].monthlyCars++;
      }
    }

    // -------- OIL --------
    if (oilChange && oilChange.toString().trim() !== "") {
      if (!oilMap[oilChange])
        oilMap[oilChange] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };

      if (isExtended) {
        oilMap[oilChange].dailyAmt += serviceAmt;
        oilMap[oilChange].dailyCars++;
      }
      if (isThisMonth) {
        oilMap[oilChange].monthlyAmt += serviceAmt;
        oilMap[oilChange].monthlyCars++;
      }
    }

    // -------- EMPLOYEE --------
    const splitAmt = serviceAmt / empNames.length;

    empNames.forEach((name) => {
      if (!empMap[name])
        empMap[name] = { daily: 0, monthly: 0, carsToday: 0, carsMonth: 0 };

      if (isExtended) {
        empMap[name].daily += splitAmt;
        empMap[name].carsToday++;

        if (!empLastWorkToday[name] || date > empLastWorkToday[name]) {
          empLastWorkToday[name] = date;
        }
      }

      if (isThisMonth) {
        empMap[name].monthly += splitAmt;
        empMap[name].carsMonth++;
      }
    });

    // -------- FOREMAN --------
    if (!isCompanyJob) {
      if (isExtended) {
        foremanMap[foremanName].daily += serviceAmt;
        foremanMap[foremanName].carsToday++;
      }
      if (isThisMonth) {
        foremanMap[foremanName].monthly += serviceAmt;
        foremanMap[foremanName].carsMonth++;
      }
    }

    // -------- TOTALS --------
    if (isExtended) {
      carsTodayIncl++;
      totalTodayIncl += actualAmt;

      if (!isCompanyJob) {
        carsTodayExcl++;
        totalTodayExcl += actualAmt;
      }
    }

    if (isThisMonth) {
      carsMonthIncl++;
      totalMonthIncl += actualAmt;

      if (!isCompanyJob) {
        carsMonthExcl++;
        totalMonthExcl += actualAmt;
      }
    }
  }

  // -------- RENDER REPORT --------
  clearReportRenderArea(sheet);

  const formatMoney = (amt) => `AED ${amt.toLocaleString("en-US")}`;
  let currentRow = 2;

  sheet
    .getRange(currentRow, 13, 1, 5)
    .merge()
    .setValue("EXTENDED SHIFT REPORT")
    .setFontWeight("bold")
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TITLE)
    .setHorizontalAlignment("center");

  currentRow++;

  sheet
    .getRange(currentRow, 13, 1, 5)
    .merge()
    .setValue("Yesterday + Today Combined")
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TIMESTAMP)
    .setHorizontalAlignment("center");

  currentRow += 2;

  // -------- SUMMARY (IDENTICAL STRUCTURE) --------
  const summaryDataExcl = [
    ["Earnings Today", formatMoney(totalTodayExcl)],
    ["Cars Washed Today", carsTodayExcl],
    ["Monthly Earnings", formatMoney(totalMonthExcl)],
    ["Cars Washed this Month", carsMonthExcl],
  ];

  const summaryDataIncl = [
    ["Earnings Today", formatMoney(totalTodayIncl)],
    ["Cars Washed Today", carsTodayIncl],
    ["Monthly Earnings", formatMoney(totalMonthIncl)],
    ["Cars Washed this Month", carsMonthIncl],
  ];

  sheet
    .getRange(currentRow, 13, summaryDataExcl.length, 2)
    .setValues(summaryDataExcl)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TABLE_BODY);
  sheet
    .getRange(currentRow, 16, summaryDataIncl.length, 2)
    .setValues(summaryDataIncl)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TABLE_BODY);

  currentRow += summaryDataExcl.length + 3;

  // -------- TABLE FUNCTION (IDENTICAL) --------
  function writeTable(title, headers, rows) {
    sheet
      .getRange(currentRow, 13, 1, headers.length)
      .merge()
      .setValue(title)
      .setFontWeight("bold")
      .setFontFamily(REPORT_FONT_FAMILY)
      .setFontSize(REPORT_FONT_SIZE.SECTION_TITLE);
    currentRow++;
    sheet
      .getRange(currentRow, 13, 1, headers.length)
      .setValues([headers])
      .setFontWeight("bold")
      .setFontFamily(REPORT_FONT_FAMILY)
      .setFontSize(REPORT_FONT_SIZE.TABLE_HEADER);
    currentRow++;
    if (rows.length) {
      sheet
        .getRange(currentRow, 13, rows.length, headers.length)
        .setValues(rows)
        .setFontFamily(REPORT_FONT_FAMILY)
        .setFontSize(REPORT_FONT_SIZE.TABLE_BODY);
      currentRow += rows.length + 2;
    } else {
      currentRow += 2;
    }
  }

  // -------- EMPLOYEE TABLE --------
  const empRows = Object.keys(empMap).map((name) => [
    name,
    formatMoney(empMap[name].daily),
    empMap[name].carsToday,
    formatMoney(empMap[name].monthly),
    empMap[name].carsMonth,
  ]);

  writeTable(
    "EMPLOYEE PERFORMANCE",
    [
      "NAME",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    empRows,
  );

  // -------- FOREMAN --------
  const foremanRows = Object.keys(foremanMap).map((name) => [
    name,
    formatMoney(foremanMap[name].daily),
    foremanMap[name].carsToday,
    formatMoney(foremanMap[name].monthly),
    foremanMap[name].carsMonth,
  ]);

  writeTable(
    "FOREMAN PERFORMANCE",
    [
      "NAME",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    foremanRows,
  );

  // -------- COMPANY --------
  const compRows = Object.keys(companyMap).map((name) => [
    name,
    formatMoney(companyMap[name].dailyAmt),
    companyMap[name].dailyCars,
    formatMoney(companyMap[name].monthlyAmt),
    companyMap[name].monthlyCars,
  ]);

  writeTable(
    "COMPANY JOBS",
    [
      "COMPANY",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    compRows,
  );

  // -------- ZEENA / OIL --------
  const zeenaOilRows = buildZeenaOilRows(zeenahMap, oilMap, formatMoney);

  writeTable(
    "ZEENA / OIL SERVICE",
    [
      "SERVICE / OIL TYPE",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    zeenaOilRows,
  );

  // -------- OIL TYPE BREAKDOWN --------
  const oilDetailRows = buildOilDetailRows(oilMap, formatMoney);
  writeTable(
    "OIL CHANGE",
    [
      "OIL TYPE",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    oilDetailRows,
  );

  SpreadsheetApp.flush();

  // -------- EXPORT PDF --------
  const url =
    `https://docs.google.com/spreadsheets/d/${ss.getId()}/export?format=pdf` +
    `&gid=${sheet.getSheetId()}&size=A4&fitw=true`;

  const blob = UrlFetchApp.fetch(url, {
    headers: { Authorization: "Bearer " + ScriptApp.getOAuthToken() },
  })
    .getBlob()
    .setName("Extended_Shift_Report.pdf");

  // -------- EMAIL --------
  MailApp.sendEmail({
    to: "imhaninmohd@gmail.com",
    subject: "Extended Shift Report (Yesterday + Today)",
    body:
      "Sir,\n\n" +
      "Extended shift analysis complete.\n" +
      "This report consolidates activity across the previous and current operational windows.\n\n" +
      "All performance metrics have been processed and verified.\n" +
      "The full report is attached for review.\n\n" +
      "No anomalies detected.",
    attachments: [blob],
  });
}

