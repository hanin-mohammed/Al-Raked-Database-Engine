function cleanupReportPipelineStage(state) {
  cleanupInterruptedCompanySpreadsheet(state);

  (state.cleanupFileIds || []).forEach(trashReportPipelineFile);

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  ["TEMP_AUDIT_EXPORT", "TEMP_MONTHLY_REPORT", "TEMP_PRIVATE_LOG"].forEach(
    (sheetName) => {
      const sheet = ss.getSheetByName(sheetName);
      if (sheet) ss.deleteSheet(sheet);
    },
  );

  const wasMonthEnd = state.isMonthEnd;
  clearReportPipelineState();

  if (wasMonthEnd && new Date().getDate() === 1) {
    const now = new Date();
    const delayMinutes =
      now.getHours() >= 2
        ? 1
        : Math.max(1, (2 - now.getHours()) * 60 - now.getMinutes() + 5);
    scheduleDeferredCleanSlate(delayMinutes);
  }
}

function runReportPipelineWorker() {
  const lock = LockService.getUserLock();
  if (!lock.tryLock(1000)) return;

  try {
    const state = getReportPipelineState();
    if (!state) return;

    const referenceDate = new Date(state.referenceIso);
    cleanupUntrackedReportPipelineFiles(state);

    if (state.activeTempSpreadsheetId) {
      cleanupInterruptedCompanySpreadsheet(state);
    }

    switch (state.stage) {
      case "DAILY_MAIN_PDF":
        createDailyMainPdfStage(state, referenceDate);
        break;
      case "DAILY_AUDIT_PDF":
        createDailyAuditPdfStage(state, referenceDate);
        break;
      case "DAILY_SEND":
        sendDailyReportStage(state, referenceDate);
        break;
      case "MONTHLY_MAIN_PDF":
        createMonthlyMainPdfStage(state, referenceDate);
        break;
      case "MONTHLY_COMPANY_FILE":
        createMonthlyCompanyFileStage(state, referenceDate);
        break;
      case "MONTHLY_SEND":
        sendMonthlyReportStage(state, referenceDate);
        break;
      case "CLEANUP":
        cleanupReportPipelineStage(state);
        return;
      default:
        throw new Error(`Unknown report pipeline stage: ${state.stage}`);
    }

    scheduleReportPipelineWorker(1);
  } catch (err) {
    const state = getReportPipelineState();
    if (state) {
      state.attempts = Number(state.attempts || 0) + 1;
      state.lastError = String(err);
      saveReportPipelineState(state);

      if (state.attempts < 3) {
        scheduleReportPipelineWorker(5);
      } else if (!state.failureEmailSent) {
        MailApp.sendEmail({
          to: "imhaninmohd@gmail.com",
          subject: "AL RAKED Report Pipeline: Recovery Required",
          body: [
            "Sir,",
            "",
            "A fault was detected in the automated report pipeline. Three recovery attempts were unsuccessful.",
            "",
            "Affected stage: " + state.stage,
            "Report date: " + state.dateKey,
            "",
            "Diagnostic detail:",
            String(err),
            "",
            "The pipeline has been secured in its current stage. Manual review is required.",
          ].join("\n"),
        });
        state.failureEmailSent = true;
        saveReportPipelineState(state);
      }
    }

    throw err;
  } finally {
    lock.releaseLock();
  }
}

function runReportPipelineWatchdog() {
  if (getReportPipelineState()) {
    runReportPipelineWorker();
    return;
  }

  cleanupUntrackedReportPipelineFiles(null);

  const today = new Date();
  if (today.getDate() !== 1 || today.getHours() < 2) return;

  const previousMonth = new Date(today.getFullYear(), today.getMonth() - 1, 1);
  const monthKey = reportPipelineMonthKey(previousMonth);
  const active = PropertiesService.getScriptProperties().getProperty(
    REPORT_PIPELINE_ACTIVE_PREFIX + monthKey,
  );

  if (active === "YES") runDeferredCleanSlate();
}

function scheduleDeferredCleanSlate(delayMinutes) {
  const handler = "runDeferredCleanSlate";

  ScriptApp.getProjectTriggers().forEach((trigger) => {
    if (trigger.getHandlerFunction() === handler) {
      ScriptApp.deleteTrigger(trigger);
    }
  });

  ScriptApp.newTrigger(handler)
    .timeBased()
    .after(Math.max(1, Number(delayMinutes) || 1) * 60 * 1000)
    .create();
}

function runMonthlyCleanSlateCheck() {
  runDeferredCleanSlate();
}

function runDeferredCleanSlate() {
  const today = new Date();
  if (today.getDate() !== 1) return;

  if (today.getHours() < 2) {
    scheduleDeferredCleanSlate(
      Math.max(1, (2 - today.getHours()) * 60 - today.getMinutes() + 5),
    );
    return;
  }

  const previousMonth = new Date(today.getFullYear(), today.getMonth() - 1, 1);
  const previousMonthLastDay = new Date(
    today.getFullYear(),
    today.getMonth(),
    0,
    23,
    30,
  );
  const monthKey = reportPipelineMonthKey(previousMonth);
  const dailyKey = reportPipelineDateKey(previousMonthLastDay);
  const properties = PropertiesService.getScriptProperties();
  const activeKey = REPORT_PIPELINE_ACTIVE_PREFIX + monthKey;

  if (properties.getProperty(activeKey) !== "YES") return;

  const archiveName = getReportPipelineArchiveName(previousMonth);
  const archiveExists = Boolean(
    SpreadsheetApp.getActiveSpreadsheet().getSheetByName(archiveName),
  );
  const dailySent =
    properties.getProperty(REPORT_PIPELINE_DAILY_SENT_PREFIX + dailyKey) ===
    "YES";
  const monthlySent =
    properties.getProperty(REPORT_PIPELINE_MONTHLY_SENT_PREFIX + monthKey) ===
    "YES";

  if (!archiveExists || !dailySent || !monthlySent) {
    if (getReportPipelineState()) scheduleReportPipelineWorker(1);
    scheduleDeferredCleanSlate(15);
    Logger.log(
      `Clean Slate waiting. Archive=${archiveExists}, daily=${dailySent}, monthly=${monthlySent}`,
    );
    return;
  }

  cleanSlateProtocol();

  properties.setProperty(
    REPORT_PIPELINE_CLEAN_SENT_PREFIX + monthKey,
    "YES",
  );
  properties.setProperty(activeKey, "COMPLETE");
}
