function getFormResponseLastRow(sheet) {
  return Math.max(
    1,
    sheet
      .getRange("A1")
      .getNextDataCell(SpreadsheetApp.Direction.DOWN)
      .getRow(),
  );
}

function getFormResponseData(sheet) {
  const lastRow = getFormResponseLastRow(sheet);
  return sheet.getRange(1, 1, lastRow, FORM_DATA_COLUMNS).getValues();
}

function getDataSheetValues(sheet) {
  return sheet.getName() === "Form Responses 1"
    ? getFormResponseData(sheet)
    : sheet.getDataRange().getValues();
}

function getAllEmployeeNamesFromSheet(data) {
  const employeeSet = new Set();

  for (let i = 1; i < data.length; i++) {
    const employeeCell = data[i][2];

    if (!employeeCell) continue;

    const employees = employeeCell
      .toString()
      .split(/,|\s+/)
      .map((e) => e.trim().toUpperCase())
      .filter(Boolean);

    employees.forEach((name) => {
      employeeSet.add(name);
    });
  }

  return Array.from(employeeSet).sort();
}

function getReportData() {
  const sheet =
    SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1");
  const data = getFormResponseData(sheet);

  const today = new Date();
  const todayStr = today.toDateString();

  const month = today.getMonth();
  const year = today.getFullYear();

  const zeenahMap = {};
  const empMap = {};
  const empLastWorkToday = {};
  const foremanMap = {};
  const companyMap = {};
  const oilMap = {};
  const serviceMap = {};

  let totalTodayIncl = 0,
    totalMonthIncl = 0;
  let totalTodayExcl = 0,
    totalMonthExcl = 0;
  let carsTodayIncl = 0,
    carsMonthIncl = 0;
  let carsTodayExcl = 0,
    carsMonthExcl = 0;

  for (let i = 1; i < data.length; i++) {
    const [
      timestamp,
      foreman,
      employee,
      licensePlate,
      service,
      serviceFee,
      company,
      oilChange,
      companyDetail,
      specialPrice,
    ] = data[i];

    if (!timestamp) continue;

    const date = new Date(timestamp);

    const isToday = date.toDateString() === todayStr;
    const isThisMonth =
      date.getMonth() === month && date.getFullYear() === year;

    let serviceAmt = 0;

    if (serviceFee && serviceFee.toString().trim().toLowerCase() !== "free") {
      serviceAmt = parseFloat(serviceFee) || 0;
    }

    let actualAmt;

    if (
      specialPrice !== "" &&
      specialPrice !== null &&
      specialPrice !== undefined
    ) {
      actualAmt = parseFloat(specialPrice) || 0;
    } else {
      actualAmt = serviceAmt;
    }

    const empNames = (employee || "")
      .toString()
      .split(/,|\s+/)
      .map((e) => e.trim())
      .filter((e) => e !== "");

    const foremanName = (foreman || "").toString().trim();

    if (empNames.length === 0 || !foremanName) continue;

    const isCompanyJob = company && company.toString().trim() !== "";

    // EMPLOYEES
    const splitAmt = serviceAmt / empNames.length;

    empNames.forEach((name) => {
      if (!empMap[name]) {
        empMap[name] = {
          daily: 0,
          monthly: 0,
          carsToday: 0,
          carsMonth: 0,
        };
      }

      if (isToday) {
        empMap[name].daily += splitAmt;
        empMap[name].carsToday++;

        if (!empLastWorkToday[name] || date > empLastWorkToday[name]) {
          empLastWorkToday[name] = date;
        }
      }

      if (isThisMonth) {
        empMap[name].monthly += splitAmt;
        empMap[name].carsMonth++;
      }
    });
    // COMPANY
    if (isCompanyJob) {
      if (!companyMap[company]) {
        companyMap[company] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      }

      if (isToday) {
        companyMap[company].dailyAmt += actualAmt;
        companyMap[company].dailyCars++;
      }

      if (isThisMonth) {
        companyMap[company].monthlyAmt += actualAmt;
        companyMap[company].monthlyCars++;
      }
    }
    // OIL
    if (oilChange && oilChange.toString().trim() !== "") {
      if (!oilMap[oilChange]) {
        oilMap[oilChange] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      }

      if (isToday) {
        oilMap[oilChange].dailyAmt += serviceAmt;
        oilMap[oilChange].dailyCars++;
      }

      if (isThisMonth) {
        oilMap[oilChange].monthlyAmt += serviceAmt;
        oilMap[oilChange].monthlyCars++;
      }
    }

    // ZEENA
    const specialServices = ["Zeena", "Perfume", "Wipers"];

    if (specialServices.includes(service)) {
      if (!zeenahMap[service]) {
        zeenahMap[service] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      }

      if (isToday) {
        zeenahMap[service].dailyAmt += serviceAmt;
        zeenahMap[service].dailyCars++;
      }

      if (isThisMonth) {
        zeenahMap[service].monthlyAmt += serviceAmt;
        zeenahMap[service].monthlyCars++;
      }
    }

    // SERVICES

    const serviceList = (service || "")
      .toString()
      .split(/\s*,\s*/) // handles comma with/without spaces
      .map((s) => s.trim().replace(/\s+/g, " ").toLowerCase())
      .filter(Boolean)
      .map((s) => {
        const aliases = {
          coolant: "Coolant",

          "outside only": "Outside Only",
          "outside inside": "Inside Outside",
          "inside outside only": "Inside Outside",

          "in site outside only": "Outside Only",

          "hot water": "Hot Water",

          "full wash": "Full Wash",
          "full wash diesel": "Full Wash Diesel",

          water: "Water",

          zeena: "Zeena",
          perfume: "Perfume",
          wipers: "Wipers",

          "oil change": "Oil Change",
        };

        s = s.toLowerCase();

        return aliases[s] || s.replace(/\b\w/g, (c) => c.toUpperCase());
      })

      // remove non-service labels
      .filter((s) => !/coupon/i.test(s) && !/%/.test(s));

    serviceList.forEach((svc) => {
      if (!serviceMap[svc]) {
        serviceMap[svc] = {
          today: {
            cars: 0,
            earnings: 0,
          },

          month: {
            cars: 0,
            earnings: 0,
          },

          todayIncl: {
            cars: 0,
            earnings: 0,
          },

          monthIncl: {
            cars: 0,
            earnings: 0,
          },
        };
      }

      if (isToday) {
        serviceMap[svc].todayIncl.cars++;

        if (!isCompanyJob) {
          serviceMap[svc].today.cars++;
        }
      }

      if (isThisMonth) {
        serviceMap[svc].monthIncl.cars++;

        if (!isCompanyJob) {
          serviceMap[svc].month.cars++;
        }
      }

      // split revenue across actual services
      const splitRevenue =
        serviceList.length > 0 ? actualAmt / serviceList.length : actualAmt;

      if (isToday) {
        serviceMap[svc].todayIncl.earnings += splitRevenue;

        if (!isCompanyJob) {
          serviceMap[svc].today.earnings += splitRevenue;
        }
      }

      if (isThisMonth) {
        serviceMap[svc].monthIncl.earnings += splitRevenue;

        if (!isCompanyJob) {
          serviceMap[svc].month.earnings += splitRevenue;
        }
      }
    });

    // TOTALS
    if (isToday) {
      carsTodayIncl++;
      totalTodayIncl += actualAmt;

      if (!isCompanyJob) {
        carsTodayExcl++;
        totalTodayExcl += actualAmt;
      }
    }

    if (isThisMonth) {
      carsMonthIncl++;
      totalMonthIncl += actualAmt;

      if (!isCompanyJob) {
        carsMonthExcl++;
        totalMonthExcl += actualAmt;
      }
    }
  }

  const attendance = {};
  const allEmployees = getAllEmployeeNamesFromSheet(data);

  for (let i = 1; i < data.length; i++) {
    const row = data[i];

    const timestamp = new Date(row[0]);

    if (isNaN(timestamp.getTime())) continue;

    const rowDate = Utilities.formatDate(
      timestamp,
      Session.getScriptTimeZone(),
      "yyyy-MM-dd",
    );

    const currentDate = Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "yyyy-MM-dd",
    );

    if (rowDate !== currentDate) continue;

    const employees = (row[2] || "")
      .toString()
      .split(/,|\s+/)
      .map((e) => e.trim().toUpperCase())
      .filter(Boolean);

    employees.forEach((name) => {
      if (!attendance[name]) {
        attendance[name] = {
          first: timestamp,
          last: timestamp,
        };
      } else {
        if (timestamp < attendance[name].first) {
          attendance[name].first = timestamp;
        }

        if (timestamp > attendance[name].last) {
          attendance[name].last = timestamp;
        }
      }
    });
  }

  return {
    generated: new Date(),

    summary: {
      today: {
        earnings: totalTodayExcl,
        cars: carsTodayExcl,
      },

      month: {
        earnings: totalMonthExcl,
        cars: carsMonthExcl,
      },

      todayIncl: {
        earnings: totalTodayIncl,
        cars: carsTodayIncl,
      },

      monthIncl: {
        earnings: totalMonthIncl,
        cars: carsMonthIncl,
      },
    },

    employees: empMap,
    lastWork: empLastWorkToday,
    companies: companyMap,
    oils: oilMap,
    zeena: zeenahMap,
    services: serviceMap,
    attendance: attendance,
    allEmployees: allEmployees,
  };
}
