function calc() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1");
  const data = sheet.getDataRange().getValues();
  const today = new Date();
  const todayStr = today.toDateString();
  const month = today.getMonth();
  const year = today.getFullYear();
  const zeenahMap = {};

  const empMap = {};
  const empLastWorkToday = {};
  const foremanMap = {};
  const companyMap = {}; 
  const oilMap = {}; 
  
  let totalTodayIncl = 0, totalMonthIncl = 0;
  let totalTodayExcl = 0, totalMonthExcl = 0;
  let carsTodayIncl = 0, carsMonthIncl = 0;
  let carsTodayExcl = 0, carsMonthExcl = 0;
  let enterpriseJobs = [];

  for (let i = 1; i < data.length; i++) {
    const [timestamp, foreman, employee, licensePlate, service, serviceFee, company, oilChange, companyDetail, specialPrice] = data[i];
    if (!timestamp) continue;
    let serviceAmt = 0;
    if (serviceFee && serviceFee.toString().trim().toLowerCase() !== "free") {
      serviceAmt = parseFloat(serviceFee) || 0;
    }

    let actualAmt;
    if (specialPrice !== "" && specialPrice !== null && specialPrice !== undefined) {
      actualAmt = parseFloat(specialPrice) || 0; // if 0 entered, that's still valid
    } else {
      actualAmt = serviceAmt; // fallback to service fee if no special price
    }

    if (
      (companyDetail && companyDetail.toString().trim() !== "") || 
      (company && company.toString().trim() === "Private Office")
    ) {
      enterpriseJobs.push([timestamp, foreman, employee, licensePlate, service, actualAmt, company, oilChange, companyDetail]);
    }

    // Skip blank rows completely
    const date = new Date(timestamp);

    const empNames = (employee || "").toString().split(",").map(e => e.trim()).filter(e => e !== "");
    const foremanName = (foreman || "").toString().trim();

    // Skip any row with missing names (prevents "Unknown")
    if (empNames.length === 0 || !foremanName) continue;

    const isToday = date.toDateString() === todayStr;
    const isThisMonth = date.getMonth() === month && date.getFullYear() === year;
    const isCompanyJob = company && company.toString().trim() !== "";

  
    if (!foremanMap[foremanName]) {
      foremanMap[foremanName] = { daily: 0, monthly: 0, carsToday: 0, carsMonth: 0 };
    }


    // Zeena, Perfume, Wiper
    const specialServices = ["Zeena", "Perfume", "Wipers"];
    if (specialServices.includes(service)) {
      if (!zeenahMap[service]) zeenahMap[service] = { dailyAmt: 0, monthlyAmt: 0, dailyCars: 0, monthlyCars: 0 };
      if (isToday) {
        zeenahMap[service].dailyCars++;
        zeenahMap[service].dailyAmt += serviceAmt;
      }
      if (isThisMonth) {
        zeenahMap[service].monthlyCars++;
        zeenahMap[service].monthlyAmt += serviceAmt;
      }
    }

    // Company
    if (isCompanyJob) {
      if (!companyMap[company]) {
        companyMap[company] = { dailyAmt: 0, monthlyAmt: 0, dailyCars: 0, monthlyCars: 0 };
      }
      if (isToday) {
        companyMap[company].dailyAmt += serviceAmt;
        companyMap[company].dailyCars++;
      }
      if (isThisMonth) {
        companyMap[company].monthlyAmt += serviceAmt;
        companyMap[company].monthlyCars++;
      }
    }

    // Oil
    if (oilChange && oilChange.toString().trim() !== "") {
      if (!oilMap[oilChange]) oilMap[oilChange] = { dailyAmt: 0, monthlyAmt: 0, dailyCars: 0, monthlyCars: 0 };
      if (isToday) {
        oilMap[oilChange].dailyAmt += serviceAmt;
        oilMap[oilChange].dailyCars++;
      }
      if (isThisMonth) {
        oilMap[oilChange].monthlyAmt += serviceAmt;
        oilMap[oilChange].monthlyCars++;
      }
    }

    // Employee (include all)
    const splitAmt = serviceAmt / empNames.length;
    empNames.forEach(name => {
      if (!empMap[name]) empMap[name] = { daily: 0, monthly: 0, carsToday: 0, carsMonth: 0 };

      if (isToday) {
        empMap[name].daily += splitAmt;
        empMap[name].carsToday++;

        // Track last job timestamp today
        if (!empLastWorkToday[name] || date > empLastWorkToday[name]) {
          empLastWorkToday[name] = date;
        }
      }

      if (isThisMonth) {
        empMap[name].monthly += splitAmt;
        empMap[name].carsMonth++;
      }
    });
  

    // Foreman (exclude company)
    if (!isCompanyJob) {
      if (isToday) {
        foremanMap[foremanName].daily += serviceAmt;
        foremanMap[foremanName].carsToday++;
      }
      if (isThisMonth) {
        foremanMap[foremanName].monthly += serviceAmt;
        foremanMap[foremanName].carsMonth++;
      }
    }

    // Totals

    if (isToday) {
      if (isCompanyJob) {
        carsTodayIncl++;
        totalTodayIncl += actualAmt;
      } else {
        carsTodayIncl++;
        carsTodayExcl++;
        totalTodayIncl += actualAmt;
        totalTodayExcl += actualAmt;
      }
    }

    if (isThisMonth) {
      if (isCompanyJob) {
        carsMonthIncl++;
        totalMonthIncl += actualAmt;
      } else {
        carsMonthIncl++;
        carsMonthExcl++;
        totalMonthIncl += actualAmt;
        totalMonthExcl += actualAmt;
      }
    }
  }

  // Clear output
  sheet.getRange("M1:R400").clearContent().clearFormat();

  const formatMoney = (amt) => `AED ${amt.toLocaleString("en-US")}`;
  let currentRow = 2;

  // HEADER
  sheet.getRange(currentRow, 13, 1, 5).merge().setValue("EARNINGS REPORT")
    .setFontWeight("bold").setFontSize(18).setFontFamily("IBM Plex Mono").setHorizontalAlignment("center");
  currentRow++;
  sheet.getRange(currentRow, 13, 1, 5).merge()
    .setValue("Last Updated: " + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd MMM yyyy HH:mm:ss"))
    .setFontSize(10).setFontFamily("IBM Plex Mono").setHorizontalAlignment("center");
  currentRow += 2;

  // SUMMARY HEADING
  sheet.getRange(currentRow, 13, 1, 5).merge().setValue("DAILY & MONTHLY SUMMARY")
    .setFontWeight("bold").setFontSize(17).setFontFamily("IBM Plex Mono").setHorizontalAlignment("center");
  currentRow++;

  // Subheadings for two distinct tables
  sheet.getRange(currentRow, 13, 1, 2).merge().setValue("WITHOUT COMPANY")
    .setFontWeight("bold").setFontFamily("IBM Plex Mono").setHorizontalAlignment("center");
  sheet.getRange(currentRow, 16, 1, 2).merge().setValue("WITH COMPANY")
    .setFontWeight("bold").setFontFamily("IBM Plex Mono").setHorizontalAlignment("center");
  currentRow++;

  const summaryDataExcl = [
    ["Earnings Today", formatMoney(totalTodayExcl)],
    ["Cars Washed Today", carsTodayExcl],
    ["Monthly Earnings", formatMoney(totalMonthExcl)],
    ["Cars Washed this Month", carsMonthExcl]
  ];
  const summaryDataIncl = [
    ["Earnings Today", formatMoney(totalTodayIncl)],
    ["Cars Washed Today", carsTodayIncl],
    ["Monthly Earnings", formatMoney(totalMonthIncl)],
    ["Cars Washed this Month", carsMonthIncl]
  ];

  // Left table
  const exclRange = sheet.getRange(currentRow, 13, summaryDataExcl.length, 2);
  exclRange.setValues(summaryDataExcl).setFontFamily("IBM Plex Mono");
  exclRange.setBorder(true, true, true, true, true, true);
  exclRange.setHorizontalAlignment("right");
  sheet.getRange(currentRow, 13, summaryDataExcl.length, 1).setFontWeight("bold").setHorizontalAlignment("left").setWrap(true).setFontFamily("IBM Plex Mono").setFontSize(14);

  // Right table
  const inclRange = sheet.getRange(currentRow, 16, summaryDataIncl.length, 2);
  inclRange.setValues(summaryDataIncl).setFontFamily("IBM Plex Mono");
  inclRange.setBorder(true, true, true, true, true, true);
  inclRange.setHorizontalAlignment("right");
  sheet.getRange(currentRow, 16, summaryDataIncl.length, 1).setFontWeight("bold").setHorizontalAlignment("left").setWrap(true).setFontFamily("IBM Plex Mono").setFontSize(14);

  // FORMAT SUMMARY VALUES

sheet.getRange(currentRow, 14, summaryDataExcl.length, 1)
  .setFontFamily("IBM Plex Mono")
  .setFontSize(16)
  .setFontWeight("bold")
  .setHorizontalAlignment("right");

sheet.getRange(currentRow, 17, summaryDataIncl.length, 1)
  .setFontFamily("IBM Plex Mono")
  .setFontSize(16)
  .setFontWeight("bold")
  .setHorizontalAlignment("right");

  currentRow += summaryDataExcl.length + 2;

  // Generic table function
  function writeTable(title, headers, rows, leftAlignCols = [0]) {
    sheet.getRange(currentRow, 13, 1, headers.length).merge().setValue(title)
      .setFontWeight("bold").setFontSize(16).setFontFamily("IBM Plex Mono").setHorizontalAlignment("center");
    currentRow++;
    sheet.getRange(currentRow, 13, 1, headers.length).setValues([headers])
      .setFontWeight("bold").setFontFamily("IBM Plex Mono");
    currentRow++;
    if (rows.length) {
      const range = sheet.getRange(currentRow, 13, rows.length, headers.length);
      range.setValues(rows).setFontFamily("IBM Plex Mono");
      range.setBorder(true, true, true, true, true, true);

      // Alignment
      range.setHorizontalAlignment("right");
      leftAlignCols.forEach(c => {
        const range = sheet.getRange(currentRow, 13 + c, rows.length, 1);
        range.setHorizontalAlignment("left");
        range.setFontWeight("bold");
      });



      currentRow += rows.length + 2;
    } else {
      currentRow += 2;
    }
  }

    // Top Performer (by cars washed this month)
  let topEmp = "", topCars = 0;
  for (let emp in empMap) {
    if (empMap[emp].carsMonth > topCars) {
      topCars = empMap[emp].carsMonth;
      topEmp = emp;
    }
  }
  sheet.getRange(currentRow, 13, 1, 5).merge().setValue(`Top Performer This Month: ${topEmp} (${topCars} VEHICLES)`)
    .setFontWeight("bold").setFontFamily("IBM Plex Mono").setHorizontalAlignment("center");
  currentRow += 2;

  // Employee
  const empList = Object.keys(empMap).sort((a, b) => empMap[b].carsToday - empMap[a].carsToday);
  const now = new Date();

  const empRows = empList.map(name => {

    let lastWorkText = "No work today";

    if (empLastWorkToday[name]) {

      const last = empLastWorkToday[name];
      const diffMinutes = Math.floor((now - last) / 60000);
      const time = Utilities.formatDate(last, Session.getScriptTimeZone(), "HH:mm");

      let timeText;

      if (diffMinutes >= 60) {
        const hours = Math.floor(diffMinutes / 60);
        const mins = diffMinutes % 60;
        timeText = mins ? `${hours}h ${mins}m` : `${hours}h`;
      } else {
        timeText = `${diffMinutes}m`;
      }

      lastWorkText = `${timeText} ago (${time})`;

    }

    return [
      `${name} · ${lastWorkText}`,
      formatMoney(empMap[name].daily),
      empMap[name].carsToday,
      formatMoney(empMap[name].monthly),
      empMap[name].carsMonth
    ];
    
  });

  writeTable(
    "EMPLOYEE PERFORMANCE",
    ["NAME", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"],
    empRows
  );



  // Foreman
  const foremanList = Object.keys(foremanMap).sort((a, b) => foremanMap[b].daily - foremanMap[a].daily);
  const foremanRows = foremanList.map(name => [
    name,
    formatMoney(foremanMap[name].daily),
    foremanMap[name].carsToday,
    formatMoney(foremanMap[name].monthly),
    foremanMap[name].carsMonth
  ]);
  writeTable("FOREMAN PERFORMANCE", ["NAME", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], foremanRows);

  // Company
  const compList = Object.keys(companyMap);
  const compRows = compList.map(name => [
    name,
    formatMoney(companyMap[name].dailyAmt),
    companyMap[name].dailyCars,
    formatMoney(companyMap[name].monthlyAmt),
    companyMap[name].monthlyCars
  ]);
  writeTable("COMPANY JOBS", ["COMPANY", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], compRows);
  // Zeena + Perfume + Wiper table
  const zeenahList = Object.keys(zeenahMap);
  const zeenahRows = zeenahList.map(svc => [
    svc,
    formatMoney(zeenahMap[svc].dailyAmt),
    zeenahMap[svc].dailyCars,
    formatMoney(zeenahMap[svc].monthlyAmt),
    zeenahMap[svc].monthlyCars
  ]);
  writeTable("ZEENA SERVICE", ["SERVICE", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], zeenahRows, [0]);

  // Oil Change
  const oilList = Object.keys(oilMap);
  const oilRows = oilList.map(oilType => [
    oilType,
    formatMoney(oilMap[oilType].dailyAmt),
    oilMap[oilType].dailyCars,
    formatMoney(oilMap[oilType].monthlyAmt),
    oilMap[oilType].monthlyCars
  ]);
  writeTable("OIL CHANGE", ["OIL TYPE", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], oilRows, [0]);
  
  if (oilRows.length) {
    sheet.getRange(currentRow - oilRows.length - 2, 13, oilRows.length, 1).setWrap(true);
  }

  // Enterprise Jobs
  if (enterpriseJobs && enterpriseJobs.length) {
    const enterpriseRows = enterpriseJobs.map(row => {
      const date = row[0] ? Utilities.formatDate(new Date(row[0]), Session.getScriptTimeZone(), "dd/MM/yy") : "";
      const price = parseFloat(row[5]) || 0;
      const formattedPrice = `AED ${price.toLocaleString("en-US")}`;
      return [date, row[3], row[4], formattedPrice, row[6], row[8]]; 
      // columns: Date, License Plate, Service, Price, Company, Detail
    });

    writeTable(
      "PRIVATE OFFICE VEHICLE LOG",
      ["DATE", "LICENSE PLATE", "SERVICE", "PRICE", "COMPANY", "DETAIL"],
      enterpriseRows
    );

    // Adjust alignment and bold manually after writing
    const startRow = currentRow - enterpriseRows.length - 2; // writeTable moves currentRow
    const sheetRange = sheet.getRange(startRow, 13, enterpriseRows.length, 6);

    // Bold all
    sheetRange.setFontWeight("bold");

    // Alignment
    for (let c = 0; c < 6; c++) {
      const colRange = sheet.getRange(startRow, 13 + c, enterpriseRows.length, 1);
      if (c === 1) colRange.setHorizontalAlignment("center"); // License Plate
      else if (c === 3) colRange.setHorizontalAlignment("right"); // Price
      else colRange.setHorizontalAlignment("left"); // Rest
    }
    sheet.getRange(startRow, 18, enterpriseRows.length, 1).setWrap(true); // Column Q
  }



}

function detectPriceChange(e) {

  const sheetName = "Form Responses 1";
  const sheet = e.source.getActiveSheet();
  if (sheet.getName() !== sheetName) return;

  const row = e.range.getRow();
  const col = e.range.getColumn();

  if (row === 1) return;

  const SERVICE_COL = 5;
  const PRICE_COL = 6;
  const SERVICE_TRACK_COL = 11;

  const rowData = sheet.getRange(row,1,1,10).getValues()[0];

  const timestamp = rowData[0];
  const entryForeman = rowData[1];
  const employee = rowData[2];
  const license = rowData[3];
  const currentService = rowData[4];
  const props = PropertiesService.getDocumentProperties();
  const key = "service_" + new Date(timestamp).getTime() + "_" + license;

  const changeTime = new Date();

  const logSheet = e.source.getSheetByName("PriceAudit");

  // --- SERVICE CHANGE TRACKING (no logging) ---
  if (col === SERVICE_COL) {

    // store original service only once
    if (!props.getProperty(key) && e.oldValue) {
      props.setProperty(key, e.oldValue);
    }

    return;
  }

  // --- PRICE CHANGE ---
  if (col !== PRICE_COL) return;

  if (typeof e.oldValue === "undefined") return;
  if (e.oldValue == e.value) return;

  const oldValue = e.oldValue;
  const newValue = e.value;

  const originalService = props.getProperty(key) || currentService;
  const newService = currentService;

  // highlight edited price
  sheet.getRange(row, PRICE_COL).setBackground("#f7c6c6");

  const data = sheet.getDataRange().getValues();
  let activeForeman = "Unknown";

  for (let i = 1; i < data.length; i++) {

    const t = new Date(data[i][0]);

    if (t <= changeTime) {
      activeForeman = data[i][1];
    } else {
      break;
    }

  }

// insert new row under header
  logSheet.insertRowAfter(1);

  const newRow = 2;

  logSheet.getRange(newRow,1,1,10).setValues([[
    changeTime,
    timestamp,
    license,
    originalService,
    newService,
    employee,
    entryForeman,
    oldValue,
    newValue,
    activeForeman
  ]]);

  SpreadsheetApp.flush();

  // copy formatting from template row
  const templateRow = logSheet.getLastRow() >= 3 ? 3 : 2;
  const template = logSheet.getRange(templateRow,1,1,10);

  template.copyFormatToRange(
    logSheet,
    1,
    10,
    newRow,
    newRow
  );
  props.deleteProperty(key);

}

