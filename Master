function getMonthlyTrendData(monthKey) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const historySheet = ss.getSheetByName("MonthlyHistory");
  const tz = Session.getScriptTimeZone();
  const today = new Date();
  const currentMonthKey = Utilities.formatDate(today, tz, "yyyy-MM");
  const targetMonth = monthKey || currentMonthKey;
  const [yearText, monthText] = targetMonth.split("-");
  const year = Number(yearText);
  const monthIndex = Number(monthText) - 1;
  const daysInMonth = new Date(year, monthIndex + 1, 0).getDate();

  let rows = [];

  if (historySheet && historySheet.getLastRow() > 1) {
    const values = historySheet
      .getRange(2, 1, historySheet.getLastRow() - 1, 5)
      .getValues();

    rows = values
      .filter((row) => {
        const monthVal = row[1];
        const monthStr = monthVal instanceof Date
          ? Utilities.formatDate(monthVal, tz, "yyyy-MM")
          : String(monthVal);
        return monthStr === targetMonth;
      })
      .map((row) => ({
        date: row[0],
        month: row[1],
        day: row[2],
        earnings: Number(row[3]) || 0,
        cars: Number(row[4]) || 0,
      }));
  }

  if (targetMonth === currentMonthKey) {
    const cachedReport = PropertiesService.getScriptProperties().getProperty(
      "TELEGRAM_REPORT_CACHE",
    );

    if (cachedReport) {
      try {
        const report = JSON.parse(cachedReport);
        const todaySummary = report && report.summary && report.summary.today;

        if (todaySummary) {
          const todayRow = {
            date: today,
            month: currentMonthKey,
            day: today.getDate(),
            earnings: Number(todaySummary.earnings) || 0,
            cars: Number(todaySummary.cars) || 0,
          };
          const existingTodayIndex = rows.findIndex(
            (row) => Number(row.day) === todayRow.day,
          );

          if (existingTodayIndex >= 0) rows[existingTodayIndex] = todayRow;
          else rows.push(todayRow);
        }
      } catch (err) {
        Logger.log("Current trend cache could not be parsed: " + err);
      }
    }
  }

  rows.sort((a, b) => Number(a.day) - Number(b.day));

  return {
    month: targetMonth,
    daysInMonth: daysInMonth,
    rows: rows,
  };
}

function buildZeenaOilRows(zeenahMap, oilMap, formatMoney) {
  const rows = Object.keys(zeenahMap)
    .sort((a, b) => a.localeCompare(b))
    .map((serviceName) => [
      serviceName,
      formatMoney(zeenahMap[serviceName].dailyAmt),
      zeenahMap[serviceName].dailyCars,
      formatMoney(zeenahMap[serviceName].monthlyAmt),
      zeenahMap[serviceName].monthlyCars,
    ]);

  const oilTypes = Object.keys(oilMap).sort((a, b) => a.localeCompare(b));
  let oilDailyAmount = 0;
  let oilDailyCars = 0;
  let oilMonthlyAmount = 0;
  let oilMonthlyCars = 0;

  oilTypes.forEach((oilType) => {
    const oil = oilMap[oilType];
    oilDailyAmount += oil.dailyAmt;
    oilDailyCars += oil.dailyCars;
    oilMonthlyAmount += oil.monthlyAmt;
    oilMonthlyCars += oil.monthlyCars;
  });

  if (oilTypes.length) {
    rows.push([
      "OIL CHANGE TOTAL",
      formatMoney(oilDailyAmount),
      oilDailyCars,
      formatMoney(oilMonthlyAmount),
      oilMonthlyCars,
    ]);
  }

  return rows;
}

function buildOilDetailRows(oilMap, formatMoney) {
