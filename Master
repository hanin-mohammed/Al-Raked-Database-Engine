function saveDailyGraphSnapshot() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let historySheet = ss.getSheetByName("MonthlyHistory");

  if (!historySheet) {
    historySheet = ss.insertSheet("MonthlyHistory");

    historySheet
      .getRange("A1:E1")
      .setValues([["Date", "MonthKey", "Day", "Earnings", "Cars"]]);

    historySheet.hideSheet();
  }

  const report = getReportData();

  const earnings = report.summary.today.earnings; // excluding company jobs
  const cars = report.summary.today.cars; // excluding company jobs

  const today = new Date();

  const monthKey = Utilities.formatDate(
    today,
    Session.getScriptTimeZone(),
    "yyyy-MM",
  );

  const dayNumber = today.getDate();

  const lastRow = historySheet.getLastRow();

  if (lastRow > 1) {
    const existingData = historySheet
      .getRange(2, 1, lastRow - 1, 3)
      .getValues();

    for (let i = 0; i < existingData.length; i++) {
      const existingMonth = existingData[i][1];
      const existingDay = existingData[i][2];

      if (existingMonth === monthKey && existingDay === dayNumber) {
        historySheet
          .getRange(i + 2, 1, 1, 5)
          .setValues([[today, monthKey, dayNumber, earnings, cars]]);

        return;
      }
    }
  }

  historySheet.appendRow([today, monthKey, dayNumber, earnings, cars]);
}

function createTriggers() {
  // Remove the old individual night triggers so they cannot overlap.
  const triggers = ScriptApp.getProjectTriggers();
  for (const t of triggers) {
    const funcName = t.getHandlerFunction();
    if (
      funcName === "calc" ||
      funcName === "emailPerformanceReport" ||
      funcName === "emailMonthlyReport" ||
      funcName === "saveYesterdaySnapshot" ||
      funcName === "saveDailyGraphSnapshot" ||
      funcName === "duplicateSheetAtMonthEnd" ||
      funcName === "runNightlyOperations"
    ) {
      ScriptApp.deleteTrigger(t);
    }
  }

  // One trigger runs every night operation in a fixed sequence. The +/-15
  // minute window remains safely before midnight.
  ScriptApp.newTrigger("runNightlyOperations")
    .timeBased()
    .atHour(23)
    .nearMinute(30)
    .everyDays(1)
    .create();
}

function runNightlyOperations() {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    calc();
    saveDailyGraphSnapshot();
  } finally {
    lock.releaseLock();
  }

  // Email exports and archive work can take considerably longer than sheet
  // writes. They do not hold the submission lock.
  emailPerformanceReport(true);
  if (TELEGRAM_ENABLED) saveYesterdaySnapshot();

  const now = new Date();
  const tomorrow = new Date(
    now.getFullYear(),
    now.getMonth(),
    now.getDate() + 1,
  );

  if (tomorrow.getMonth() !== now.getMonth()) {
    let monthlyError = null;

    try {
      emailMonthlyReport(true);
    } catch (err) {
      monthlyError = err;
      Logger.log("Monthly report failed: " + err);
    } finally {
      // Preserve the raw monthly archive even if attachment export fails.
      duplicateSheetAtMonthEnd();
    }

    if (monthlyError) throw monthlyError;
  }
}
