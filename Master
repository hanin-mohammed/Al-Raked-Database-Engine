function emailPerformanceReport(skipCalc) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName("Form Responses 1");
    const auditSheet = ss.getSheetByName("PriceAudit");

    if (!skipCalc) calc();

    SpreadsheetApp.flush();

    const today = new Date();
    const timeZone = Session.getScriptTimeZone();

    const subjectDate = Utilities.formatDate(today, timeZone, "MMMM d, yyyy");

    const fileDate = Utilities.formatDate(
      today,
      timeZone,
      "MMMM d yyyy",
    ).replace(/ /g, "_");

    const exportUrl =
      `https://docs.google.com/spreadsheets/d/${ss.getId()}/export?format=pdf` +
      `&size=A4&portrait=true&fitw=true&sheetnames=false&printtitle=false` +
      `&pagenumbers=false&gridlines=false&fzr=false&gid=${sheet.getSheetId()}`;

    const options = {
      headers: {
        Authorization: "Bearer " + ScriptApp.getOAuthToken(),
      },
      muteHttpExceptions: true,
    };

    const mainResponse = UrlFetchApp.fetch(exportUrl, options);

    if (mainResponse.getResponseCode() !== 200) {
      throw new Error("Main PDF export failed.");
    }

    const mainPdf = mainResponse
      .getBlob()
      .setName(`${fileDate}_Al_Raked_Performance_Report.pdf`);

    let attachments = [mainPdf];

    const auditData = auditSheet.getDataRange().getValues();

    const rowsToday = [];

    for (let i = 1; i < auditData.length; i++) {
      const changeTime = new Date(auditData[i][0]);

      if (changeTime.toDateString() === today.toDateString()) {
        rowsToday.push(auditData[i].slice(0, 10));
      }
    }

