        .setFontSize(12) // change this number
        .setWrap(true);

      range.setBorder(true, true, true, true, true, true);

      // Alignment
      range.setHorizontalAlignment("right");
      leftAlignCols.forEach((c) => {
        const range = sheet.getRange(currentRow, 13 + c, rows.length, 1);
        range.setHorizontalAlignment("left");
        range.setFontWeight("bold");
      });

      currentRow += rows.length + 2;
    } else {
      currentRow += 2;
    }
  }

  // Top Performer (by cars washed this month)
  let topEmp = "",
    topCars = 0;
  for (let emp in empMap) {
    if (empMap[emp].carsMonth > topCars) {
      topCars = empMap[emp].carsMonth;
      topEmp = emp;
    }
  }
  sheet
    .getRange(currentRow, 13, 1, 5)
    .merge()
    .setValue(`Top Performer This Month: ${topEmp} (${topCars} VEHICLES)`)
    .setFontWeight("bold")
    .setFontFamily("IBM Plex Sans")
    .setHorizontalAlignment("center");
  currentRow += 2;

  // Employee
  const empList = Object.keys(empMap).sort(
    (a, b) => empMap[b].carsToday - empMap[a].carsToday,
  );
  const now = new Date();

  const empRows = empList.map((name) => {
    let lastWorkText = "No work today";

    if (empLastWorkToday[name]) {
      const last = empLastWorkToday[name];
      const diffMinutes = Math.floor((now - last) / 60000);
      const time = Utilities.formatDate(
        last,
        Session.getScriptTimeZone(),
        "HH:mm",
      );

      let timeText;

      if (diffMinutes >= 60) {
        const hours = Math.floor(diffMinutes / 60);
        const mins = diffMinutes % 60;
        timeText = mins ? `${hours}h ${mins}m` : `${hours}h`;
      } else {
        timeText = `${diffMinutes}m`;
      }

      lastWorkText = `${timeText} ago (${time})`;
    }

    return [
      `${name} · ${lastWorkText}`,
      formatMoney(empMap[name].daily),
      empMap[name].carsToday,
      formatMoney(empMap[name].monthly),
      empMap[name].carsMonth,
    ];
  });

  writeTable(
    "EMPLOYEE PERFORMANCE",
    [
      "NAME",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    empRows,
  );

  // Foreman
  const foremanList = Object.keys(foremanMap).sort(
    (a, b) => foremanMap[b].daily - foremanMap[a].daily,
  );
  const foremanRows = foremanList.map((name) => [
    name,
    formatMoney(foremanMap[name].daily),
    foremanMap[name].carsToday,
    formatMoney(foremanMap[name].monthly),
    foremanMap[name].carsMonth,
  ]);
  writeTable(
    "FOREMAN PERFORMANCE",
    [
      "NAME",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    foremanRows,
  );

  // Company
  const compList = Object.keys(companyMap);
  const compRows = compList.map((name) => [
    name,
    formatMoney(companyMap[name].dailyAmt),
    companyMap[name].dailyCars,
    formatMoney(companyMap[name].monthlyAmt),
    companyMap[name].monthlyCars,
  ]);
  writeTable(
    "COMPANY JOBS",
    [
      "COMPANY",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    compRows,
  );
  // Zeena + Perfume + Wiper table
  const zeenahList = Object.keys(zeenahMap);
  const zeenahRows = zeenahList.map((svc) => [
    svc,
    formatMoney(zeenahMap[svc].dailyAmt),
    zeenahMap[svc].dailyCars,
    formatMoney(zeenahMap[svc].monthlyAmt),
    zeenahMap[svc].monthlyCars,
  ]);
  writeTable(
    "ZEENA SERVICE",
    [
      "SERVICE",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    zeenahRows,
    [0],
  );

  // Oil Change
  const oilList = Object.keys(oilMap);
  const oilRows = oilList.map((oilType) => [
    oilType,
    formatMoney(oilMap[oilType].dailyAmt),
    oilMap[oilType].dailyCars,
    formatMoney(oilMap[oilType].monthlyAmt),
    oilMap[oilType].monthlyCars,
  ]);
  writeTable(
    "OIL CHANGE",
    [
      "OIL TYPE",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    oilRows,
    [0],
  );

  if (oilRows.length) {
    sheet
      .getRange(currentRow - oilRows.length - 2, 13, oilRows.length, 1)
      .setWrap(true);
  }

  // Enterprise Jobs
  if (enterpriseJobs && enterpriseJobs.length) {
    const enterpriseRows = enterpriseJobs.map((row) => {
      const date = row[0] ? new Date(row[0]) : "";
      const price = parseFloat(row[5]) || 0;
      const formattedPrice = `AED ${price.toLocaleString("en-US")}`;
      return [date, row[3], row[4], formattedPrice, row[6], row[8]];
      // columns: Date, License Plate, Service, Price, Company, Detail
    });

    writeTable(
      "PRIVATE OFFICE VEHICLE LOG",
      ["DATE", "LICENSE PLATE", "SERVICE", "PRICE", "COMPANY", "DETAIL"],
      enterpriseRows,
    );

    // Adjust alignment and bold manually after writing
    const startRow = currentRow - enterpriseRows.length - 2; // writeTable moves currentRow
    const sheetRange = sheet.getRange(startRow, 13, enterpriseRows.length, 6);

    sheet
      .getRange(startRow, 13, enterpriseRows.length, 1)
      .setNumberFormat("dd/MM/yy");

    // Bold all
    sheetRange.setFontWeight("bold");

    // Alignment
    for (let c = 0; c < 6; c++) {
      const colRange = sheet.getRange(
        startRow,
        13 + c,
        enterpriseRows.length,
        1,
      );
      if (c === 1)
        colRange.setHorizontalAlignment("center"); // License Plate
      else if (c === 3)
        colRange.setHorizontalAlignment("right"); // Price
      else colRange.setHorizontalAlignment("left"); // Rest
    }
    sheet.getRange(startRow, 18, enterpriseRows.length, 1).setWrap(true); // Column Q
  }

  updateTelegramCache();
}

function auditPriceChange(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(5000); // wait up to 5 seconds for previous edit to finish

  try {
    const MAIN = "Form Responses 1";
    const AUDIT = "PriceAudit";

    const SERVICE_COL = 5;
    const PRICE_COL = 6;
    const MERGE_WINDOW_MINUTES = 30;

    const sheet = e.range.getSheet();
    if (sheet.getName() !== MAIN) return;

    const row = e.range.getRow();
    const col = e.range.getColumn();

    if (row === 1) return;
    if (col !== SERVICE_COL && col !== PRICE_COL) return;

    if (col === SERVICE_COL && e.oldValue === e.value) return;
    if (col === PRICE_COL && e.oldValue === e.value) return;

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const audit = ss.getSheetByName(AUDIT);

    const rowData = sheet.getRange(row, 1, 1, 10).getValues()[0];

    const timestamp = rowData[0];
    const entryForeman = rowData[1];
    const employee = rowData[2];
    const license = rowData[3];

    const service = rowData[4];
    const price = rowData[5];

    const changeTime = new Date();

    // Re-locate the correct row in case sorting moved it
    const allData = sheet.getDataRange().getValues();
    let correctRow = row;

    for (let i = 1; i < allData.length; i++) {
      const t = allData[i][0];
      const plate = allData[i][3];

      if (
        new Date(t).getTime() === new Date(timestamp).getTime() &&
        plate === license
      ) {
        correctRow = i + 1;
        break;
      }
    }

    // Highlight correct row even if sheet sorted
    sheet.getRange(correctRow, col).setBackground("#f7c6c6");
    SpreadsheetApp.flush();

    let oldService = service;
    let newService = service;

    let oldPrice = price;
    let newPrice = price;

    if (col === SERVICE_COL) {
      if (typeof e.oldValue !== "undefined") {
        oldService = e.oldValue;
      } else if (existingRow) {
        oldService = audit.getRange(existingRow, 5).getValue();
      } else {
        oldService = service;
      }

      newService = service;
    }

    if (col === PRICE_COL) {
      if (typeof e.oldValue === "undefined") return;

      oldPrice = e.oldValue;
      newPrice = price;
    }

    const data = sheet.getDataRange().getValues();
    let activeForeman = entryForeman;

    for (let i = 1; i < data.length; i++) {
      const t = new Date(data[i][0]);

      if (t <= changeTime) {
        activeForeman = data[i][1];
      } else {
        break;
      }
    }

    const lastRow = audit.getLastRow();

    let existingRow = null;

    if (lastRow >= 2) {
      const newest = audit.getRange(2, 1, 1, 10).getValues()[0];

      const logTimestamp = new Date(newest[1]).getTime();
      const logPlate = newest[2];
      const previousChangeTime = new Date(newest[0]).getTime();

      const sameJob =
        logTimestamp === new Date(timestamp).getTime() && logPlate === license;

      const minutesSinceLastChange =
        (changeTime.getTime() - previousChangeTime) / 60000;

      if (sameJob && minutesSinceLastChange <= MERGE_WINDOW_MINUTES) {
        existingRow = 2;
      }
    }

    const values = [
      changeTime,
      timestamp,
      license,
      oldService,
      newService,
      employee,
      entryForeman,
      oldPrice,
      newPrice,
      activeForeman,
    ];

    if (existingRow) {
      const prev = audit.getRange(existingRow, 1, 1, 10).getValues()[0];

      let finalOldService = prev[3];
      let finalNewService = prev[4];
      let finalOldPrice = prev[7];
      let finalNewPrice = prev[8];

      if (col === SERVICE_COL) {
        finalOldService = prev[3] || oldService;
        finalNewService = newService;
      }

      if (col === PRICE_COL) {
        finalOldPrice = prev[7] || oldPrice;
        finalNewPrice = newPrice;
      }

      const mergedValues = [
        changeTime,
        timestamp,
        license,
        finalOldService,
        finalNewService,
        employee,
        entryForeman,
        finalOldPrice,
        finalNewPrice,
        activeForeman,
      ];

      audit.getRange(existingRow, 1, 1, 10).setValues([mergedValues]);
    } else {
      audit.insertRowAfter(1);

      const newRow = 2;

      audit.getRange(newRow, 1, 1, 10).setValues([values]);

      SpreadsheetApp.flush();

      // Copy formatting template from Row 1 (K–T) → new row (A–J)
      audit
        .getRange(1, 11, 1, 10)
        .copyTo(audit.getRange(newRow, 1, 1, 10), { formatOnly: true });

      audit.getRange(newRow, 1, 1, 10).setFontColor("black");
    }

    if (audit.getLastRow() > 2) {
      audit
        .getRange(2, 1, audit.getLastRow() - 1, 10)
        .sort({ column: 1, ascending: false });
    }
  } finally {
    lock.releaseLock();
  }
}

