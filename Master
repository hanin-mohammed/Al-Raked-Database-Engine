function processFormSubmission() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1"); // change if needed
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  // 1. Unmerge everything to prevent sort errors
  sheet.getRange(1, 1, sheet.getMaxRows(), sheet.getMaxColumns()).breakApart();

  // 2. Sort by Timestamp (Column A) descending — newest entries first
  if (lastRow > 1) {
    const sortRange = sheet.getRange(2, 1, lastRow - 1, lastCol);
    sortRange.sort({ column: 1, ascending: false });
  }

  // 3. Copy formatting from row 3 (previous top) to row 2 (newest entry)
  if (lastRow >= 3) {
    const sourceFormat = sheet.getRange(3, 1, 1, lastCol);
    const targetFormat = sheet.getRange(2, 1, 1, lastCol);
    sourceFormat.copyFormatToRange(sheet, 1, lastCol, 2, 2);
  }


}

