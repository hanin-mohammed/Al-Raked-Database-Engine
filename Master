function calc() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const data = sheet.getDataRange().getValues();
  const today = new Date();
  const todayStr = today.toDateString();
  const month = today.getMonth();
  const year = today.getFullYear();

  const empMap = {};
  const foremanMap = {};
  const companyMap = {}; 
  const oilMap = {}; 
  let totalTodayIncl = 0, totalMonthIncl = 0;
  let totalTodayExcl = 0, totalMonthExcl = 0;
  let carsTodayIncl = 0, carsMonthIncl = 0;
  let carsTodayExcl = 0, carsMonthExcl = 0;
  let zeenahTodayCars = 0, zeenahMonthCars = 0;
  let zeenahTodayAmt = 0, zeenahMonthAmt = 0;

  for (let i = 1; i < data.length; i++) {
    const [timestamp, foreman, employee, , service, price, company, oilChange] = data[i];
    const date = new Date(timestamp);
    let amt = 0;
    if (price && price.toString().trim().toLowerCase() !== "free") {
      amt = parseFloat(price) || 0;
    }

    // Skip blank rows completely
    if (!timestamp) continue;

    const empName = (employee || "").toString().trim();
    const foremanName = (foreman || "").toString().trim();

    // Skip any row with missing names (prevents "Unknown")
    if (!empName || !foremanName) continue;

    const isToday = date.toDateString() === todayStr;
    const isThisMonth = date.getMonth() === month && date.getFullYear() === year;
    const isCompanyJob = company && company.toString().trim() !== "";

    if (!empMap[empName]) empMap[empName] = { daily: 0, monthly: 0, carsToday: 0, carsMonth: 0 };
    if (!foremanMap[foremanName]) foremanMap[foremanName] = { daily: 0, monthly: 0, carsToday: 0, carsMonth: 0 };

    // Zeenah
    if (service === "Zeena") {
      if (isToday) {
        zeenahTodayCars++;
        zeenahTodayAmt += amt;
      }
      if (isThisMonth) {
        zeenahMonthCars++;
        zeenahMonthAmt += amt;
      }
    }

    // Company
    if (isCompanyJob) {
      if (!companyMap[company]) companyMap[company] = { dailyAmt: 0, monthlyAmt: 0, dailyCars: 0, monthlyCars: 0 };
      if (isToday) {
        companyMap[company].dailyAmt += amt;
        companyMap[company].dailyCars++;
      }
      if (isThisMonth) {
        companyMap[company].monthlyAmt += amt;
        companyMap[company].monthlyCars++;
      }
    }

    // Oil
    if (oilChange && oilChange.toString().trim() !== "") {
      if (!oilMap[oilChange]) oilMap[oilChange] = { dailyAmt: 0, monthlyAmt: 0, dailyCars: 0, monthlyCars: 0 };
      if (isToday) {
        oilMap[oilChange].dailyAmt += amt;
        oilMap[oilChange].dailyCars++;
      }
      if (isThisMonth) {
        oilMap[oilChange].monthlyAmt += amt;
        oilMap[oilChange].monthlyCars++;
      }
    }

    // Employee (include all)
    if (isToday) {
      empMap[empName].daily += amt;
      empMap[empName].carsToday++;
    }
    if (isThisMonth) {
      empMap[empName].monthly += amt;
      empMap[empName].carsMonth++;
    }

    // Foreman (exclude company)
    if (!isCompanyJob) {
      if (isToday) {
        foremanMap[foremanName].daily += amt;
        foremanMap[foremanName].carsToday++;
      }
      if (isThisMonth) {
        foremanMap[foremanName].monthly += amt;
        foremanMap[foremanName].carsMonth++;
      }
    }

    // Totals
    if (isToday) {
      totalTodayIncl += amt;
      carsTodayIncl++;
      if (!isCompanyJob) {
        totalTodayExcl += amt;
        carsTodayExcl++;
      }
    }
    if (isThisMonth) {
      totalMonthIncl += amt;
      carsMonthIncl++;
      if (!isCompanyJob) {
        totalMonthExcl += amt;
        carsMonthExcl++;
      }
    }
  }

  // Clear output
  sheet.getRange("L1:R200").clearContent().clearFormat();

  const formatMoney = (amt) => `AED ${amt.toLocaleString("en-US")}`;
  let currentRow = 1;

  // HEADER
  sheet.getRange(currentRow, 12, 1, 5).merge().setValue("EARNINGS REPORT")
    .setFontWeight("bold").setFontSize(14).setFontFamily("DM Sans").setHorizontalAlignment("center");
  currentRow++;
  sheet.getRange(currentRow, 12, 1, 5).merge()
    .setValue("Last Updated: " + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd MMM yyyy HH:mm:ss"))
    .setFontSize(10).setFontFamily("DM Sans").setHorizontalAlignment("center");
  currentRow += 2;

  // SUMMARY HEADING
  sheet.getRange(currentRow, 12, 1, 5).merge().setValue("DAILY & MONTHLY SUMMARY")
    .setFontWeight("bold").setFontSize(12).setFontFamily("DM Sans").setHorizontalAlignment("center");
  currentRow++;

  // Subheadings for two distinct tables
  sheet.getRange(currentRow, 12, 1, 2).merge().setValue("EXCLUDING COMPANY")
    .setFontWeight("bold").setFontFamily("DM Sans").setHorizontalAlignment("center");
  sheet.getRange(currentRow, 15, 1, 2).merge().setValue("INCLUDING COMPANY")
    .setFontWeight("bold").setFontFamily("DM Sans").setHorizontalAlignment("center");
  currentRow++;

  const summaryDataExcl = [
    ["Earnings Today", formatMoney(totalTodayExcl)],
    ["Cars Washed Today", carsTodayExcl],
    ["Monthly Earnings", formatMoney(totalMonthExcl)],
    ["Cars Washed This Month", carsMonthExcl]
  ];
  const summaryDataIncl = [
    ["Earnings Today", formatMoney(totalTodayIncl)],
    ["Cars Washed Today", carsTodayIncl],
    ["Monthly Earnings", formatMoney(totalMonthIncl)],
    ["Cars Washed This Month", carsMonthIncl]
  ];

  // Left table
  const exclRange = sheet.getRange(currentRow, 12, summaryDataExcl.length, 2);
  exclRange.setValues(summaryDataExcl).setFontFamily("DM Sans");
  exclRange.setBorder(true, true, true, true, true, true);
  exclRange.setHorizontalAlignment("right");
  sheet.getRange(currentRow, 12, summaryDataExcl.length, 1).setHorizontalAlignment("left");

  // Right table
  const inclRange = sheet.getRange(currentRow, 15, summaryDataIncl.length, 2);
  inclRange.setValues(summaryDataIncl).setFontFamily("DM Sans");
  inclRange.setBorder(true, true, true, true, true, true);
  inclRange.setHorizontalAlignment("right");
  sheet.getRange(currentRow, 15, summaryDataIncl.length, 1).setHorizontalAlignment("left");

  currentRow += summaryDataExcl.length + 2;

  // Generic table function
  function writeTable(title, headers, rows, leftAlignCols = [0]) {
    sheet.getRange(currentRow, 12, 1, headers.length).merge().setValue(title)
      .setFontWeight("bold").setFontSize(12).setFontFamily("DM Sans").setHorizontalAlignment("center");
    currentRow++;
    sheet.getRange(currentRow, 12, 1, headers.length).setValues([headers])
      .setFontWeight("bold").setFontFamily("DM Sans");
    currentRow++;
    if (rows.length) {
      const range = sheet.getRange(currentRow, 12, rows.length, headers.length);
      range.setValues(rows).setFontFamily("DM Sans");
      range.setBorder(true, true, true, true, true, true);

      // Alignment
      range.setHorizontalAlignment("right");
      leftAlignCols.forEach(c => sheet.getRange(currentRow, 12 + c, rows.length, 1).setHorizontalAlignment("left"));

      currentRow += rows.length + 2;
    } else {
      currentRow += 2;
    }
  }

  // Top Earner
  let topEmp = "", topAmt = 0;
  for (let emp in empMap) {
    if (empMap[emp].monthly > topAmt) {
      topAmt = empMap[emp].monthly;
      topEmp = emp;
    }
  }
  sheet.getRange(currentRow, 12, 1, 5).merge().setValue(`TOP EARNER THIS MONTH: ${topEmp} (${formatMoney(topAmt)})`)
    .setFontWeight("bold").setFontFamily("DM Sans").setHorizontalAlignment("center");
  currentRow += 2;

  // Employee
  const empList = Object.keys(empMap).sort((a, b) => empMap[b].daily - empMap[a].daily);
  const empRows = empList.map(name => [
    name,
    formatMoney(empMap[name].daily),
    empMap[name].carsToday,
    formatMoney(empMap[name].monthly),
    empMap[name].carsMonth
  ]);
  writeTable("EMPLOYEE PERFORMANCE", ["NAME", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], empRows);

  // Foreman
  const foremanList = Object.keys(foremanMap).sort((a, b) => foremanMap[b].daily - foremanMap[a].daily);
  const foremanRows = foremanList.map(name => [
    name,
    formatMoney(foremanMap[name].daily),
    foremanMap[name].carsToday,
    formatMoney(foremanMap[name].monthly),
    foremanMap[name].carsMonth
  ]);
  writeTable("FOREMAN PERFORMANCE", ["NAME", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], foremanRows);

  // Company
  const compList = Object.keys(companyMap);
  const compRows = compList.map(name => [
    name,
    formatMoney(companyMap[name].dailyAmt),
    companyMap[name].dailyCars,
    formatMoney(companyMap[name].monthlyAmt),
    companyMap[name].monthlyCars
  ]);
  writeTable("COMPANY JOBS", ["COMPANY", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], compRows);

  // Zeenah
  const zeenahRows = [
    ["Zeena", formatMoney(zeenahTodayAmt), zeenahTodayCars, formatMoney(zeenahMonthAmt), zeenahMonthCars]
  ];
  writeTable("ZEENA SERVICE", ["SERVICE", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], zeenahRows);

  // Oil Change
  const oilList = Object.keys(oilMap);
  const oilRows = oilList.map(oilType => [
    oilType,
    formatMoney(oilMap[oilType].dailyAmt),
    oilMap[oilType].dailyCars,
    formatMoney(oilMap[oilType].monthlyAmt),
    oilMap[oilType].monthlyCars
  ]);
  writeTable("OIL CHANGE", ["OIL TYPE", "EARNINGS TODAY", "CARS TODAY", "EARNINGS THIS MONTH", "CARS THIS MONTH"], oilRows, [0]);
}

