function createDailyAuditPdfStage(state, referenceDate) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const auditSheet = ss.getSheetByName("PriceAudit");
  const tz = Session.getScriptTimeZone();
  const fileDate = Utilities.formatDate(
    referenceDate,
    tz,
    "MMMM d yyyy",
  ).replace(/ /g, "_");
  const auditData = auditSheet.getDataRange().getValues();
  const rowsForDate = [];

  for (let i = 1; i < auditData.length; i++) {
    const changeTime = auditData[i][0];
    if (!changeTime) continue;

    if (reportPipelineDateKey(new Date(changeTime)) === state.dateKey) {
      rowsForDate.push(auditData[i].slice(0, 10));
    }
  }

  state.dailyAuditText = "No price changes recorded today.";

  if (rowsForDate.length) {
    const tempName = "TEMP_AUDIT_EXPORT";
    const existing = ss.getSheetByName(tempName);
    if (existing) ss.deleteSheet(existing);

    const temp = ss.insertSheet(tempName);

    try {
      auditSheet.getRange(1, 1, 1, 10).copyTo(temp.getRange(1, 1));
      temp.getRange(1, 1, 1, 10).setFontColor("white");
      temp.getRange(2, 1, rowsForDate.length, 10).setValues(rowsForDate);
      temp.getRange(2, 1, rowsForDate.length, 10).setFontColor("black");
      SpreadsheetApp.flush();

      const auditUrl =
        `https://docs.google.com/spreadsheets/d/${ss.getId()}/export?format=pdf` +
        `&size=A4&portrait=true&fitw=true&sheetnames=false&printtitle=false` +
        `&pagenumbers=false&gridlines=true&fzr=false&gid=${temp.getSheetId()}`;
      const response = UrlFetchApp.fetch(
        auditUrl,
        reportPipelineFetchOptions(),
      );

      if (response.getResponseCode() === 200) {
        const fileName = `${fileDate}_Price_Audit.pdf`;
        const file = getReportPipelineTempFolder().createFile(
          response.getBlob().setName(fileName),
        );
        state.dailyAuditFileId = rememberReportPipelineFile(state, file);
        state.dailyAuditText = `${rowsForDate.length} price change(s) recorded today.`;
      }
    } finally {
      const tempToDelete = ss.getSheetByName(tempName);
      if (tempToDelete) ss.deleteSheet(tempToDelete);
    }
  }

  state.stage = "DAILY_SEND";
  state.attempts = 0;
  saveReportPipelineState(state);
}

