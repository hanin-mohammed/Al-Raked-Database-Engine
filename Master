// PRICE MENU FUNCTIONS
function viewPrice() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return; // No data
  sheet.getRange(2, 6, lastRow - 1, 1).setFontColor("black"); // Column F
}

function hidePrice() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return; // No data
  sheet.getRange(2, 6, lastRow - 1, 1).setFontColor("white"); // Column F
}

