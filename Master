function emailPerformanceReport() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();

  // 1. Generate latest report
  calc();

  // 2. Format the date for subject and file name
  const today = new Date();
  const timeZone = Session.getScriptTimeZone();
  
  // Full month name for both
  const subjectDate = Utilities.formatDate(today, timeZone, "MMMM d, yyyy"); // e.g., August 3, 2025
  const fileDate = Utilities.formatDate(today, timeZone, "MMMM d yyyy")      // e.g., August 3 2025
    .replace(/ /g, "_"); // Convert spaces to underscores for file name

  // 3. Create PDF export link for the active sheet
  const url = `https://docs.google.com/spreadsheets/d/${ss.getId()}/export?format=pdf&` +
    `size=A4&portrait=true&fitw=true&sheetnames=false&printtitle=false` +
    `&pagenumbers=false&gridlines=false&fzr=false&gid=${sheet.getSheetId()}`;

  const options = {
    headers: { Authorization: "Bearer " + ScriptApp.getOAuthToken() }
  };

  // 4. Fetch PDF file
  const response = UrlFetchApp.fetch(url, options);
  const blob = response.getBlob().setName(
    `${fileDate}_Al_Raked_Performance_Report.pdf`
  );

  // 5. Email the PDF
  MailApp.sendEmail({
    to: "alrakedcarwashingstation@gmail.com",
    subject: `${subjectDate} - Al Raked Performance Report`,
    body: "Attached is the daily performance report for today.",
    attachments: [blob]
  });
}

function createTriggers() {
  // Delete all existing triggers for calc and emailPerformanceReport to avoid duplicates
  const triggers = ScriptApp.getProjectTriggers();
  for (const t of triggers) {
    const funcName = t.getHandlerFunction();
    if (funcName === "calc" || funcName === "emailPerformanceReport") {
      ScriptApp.deleteTrigger(t);
    }
  }


  // Run calc() at 11:30 PM daily (final update before email)
  ScriptApp.newTrigger("calc")
    .timeBased()
    .atHour(23)
    .nearMinute(30)
    .everyDays(1)
    .create();

  // Send email report at 11:45 PM daily
  ScriptApp.newTrigger("emailPerformanceReport")
    .timeBased()
    .atHour(23)
    .nearMinute(45)
    .everyDays(1)
    .create();
}

function sevenDaySummary() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const data = sheet.getDataRange().getValues();
  const today = new Date();
  const todayStr = today.toDateString();

  // Track 7-day data (excluding today)
  const dailyExcl = {};
  const dailyIncl = {};

  // Last 7 dates (excluding today)
  const last7Dates = [];
  for (let d = 1; d <= 7; d++) {
    const past = new Date(today);
    past.setDate(today.getDate() - d);
    const key = past.toDateString();
    last7Dates.push({ key, date: new Date(past) });
    dailyExcl[key] = { amt: 0, cars: 0 };
    dailyIncl[key] = { amt: 0, cars: 0 };
  }

  // Process rows
  for (let i = 1; i < data.length; i++) {
    const [timestamp, , , , , price, company] = data[i];
    if (!timestamp) continue;
    const rowDate = new Date(timestamp);
    const rowKey = rowDate.toDateString();
    if (!dailyIncl[rowKey]) continue;

    let amt = 0;
    if (price && price.toString().trim().toLowerCase() !== "free") {
      amt = parseFloat(price) || 0;
    }

    const isCompanyJob = company && company.toString().trim() !== "";

    // Including company
    dailyIncl[rowKey].amt += amt;
    dailyIncl[rowKey].cars++;

    // Excluding company
    if (!isCompanyJob) {
      dailyExcl[rowKey].amt += amt;
      dailyExcl[rowKey].cars++;
    }
  }

  // Clear old block
  sheet.getRange("S4:W200").clearContent().clearFormat();
  let row = 4;

  const formatMoney = (amt) => `AED ${amt.toLocaleString("en-US")}`;

  // Header
  sheet.getRange(row, 19, 1, 5).merge()
    .setValue("7-DAY SUMMARY")
    .setFontWeight("bold").setFontSize(12).setFontFamily("DM Sans")
    .setHorizontalAlignment("center");
  row++;

  // Column headers
  const headers = [["DATE", "EARNINGS", "CARS", "EARNINGS (COMPANY)", "CARS (COMPANY)"]];
  sheet.getRange(row, 19, 1, 5).setValues(headers)
    .setFontWeight("bold").setFontFamily("DM Sans")
    .setHorizontalAlignment("left");
  row++;

  // Rows
  const rows = last7Dates.map(obj => {
    const dLabel = Utilities.formatDate(obj.date, Session.getScriptTimeZone(), "EEE, dd MMM"); // day added
    return [
      dLabel,
      formatMoney(dailyExcl[obj.key].amt),
      dailyExcl[obj.key].cars,
      formatMoney(dailyIncl[obj.key].amt),
      dailyIncl[obj.key].cars
    ];
  });

  const range = sheet.getRange(row, 19, rows.length, 5);
  range.setValues(rows).setFontFamily("DM Sans");
  range.setBorder(true, true, true, true, true, true);
  range.setHorizontalAlignment("right");
  sheet.getRange(row, 19, rows.length, 1).setHorizontalAlignment("left");
}

function createSevenDayTrigger() {
  // Delete old trigger if exists
  const triggers = ScriptApp.getProjectTriggers();
  for (const t of triggers) {
    if (t.getHandlerFunction() === "sevenDaySummary") {
      ScriptApp.deleteTrigger(t);
    }
  }
  // Run at 1 AM daily
  ScriptApp.newTrigger("sevenDaySummary")
    .timeBased()
    .atHour(1)
    .everyDays(1)
    .create();
}


