  const oilMap = {};

  let totalTodayIncl = 0,
    totalMonthIncl = 0;
  let totalTodayExcl = 0,
    totalMonthExcl = 0;
  let carsTodayIncl = 0,
    carsMonthIncl = 0;
  let carsTodayExcl = 0,
    carsMonthExcl = 0;
  const companyJobs = {};

  for (let i = 1; i < data.length; i++) {
    const [
      timestamp,
      foreman,
      employee,
      licensePlate,
      service,
      serviceFee,
      company,
      oilChange,
      companyDetail,
      specialPrice,
    ] = data[i];
    if (!timestamp) continue;
    let serviceAmt = 0;
    if (serviceFee && serviceFee.toString().trim().toLowerCase() !== "free") {
      serviceAmt = parseFloat(serviceFee) || 0;
    }

    let actualAmt;
    if (
      specialPrice !== "" &&
      specialPrice !== null &&
      specialPrice !== undefined
    ) {
      actualAmt = parseFloat(specialPrice) || 0; // if 0 entered, that's still valid
    } else {
      actualAmt = serviceAmt; // fallback to service fee if no special price
    }

    const companyName = (company || "").toString().trim();

    if (companyName) {
      if (!companyJobs[companyName]) companyJobs[companyName] = [];

      companyJobs[companyName].push([
        timestamp,
        foreman,
        employee,
        licensePlate,
        service,
        actualAmt,
        companyName,
        oilChange,
        companyDetail,
      ]);
    }

    // Skip blank rows completely
    const date = new Date(timestamp);

    const empNames = (employee || "")
      .toString()
      .split(/,|\s+/) // split by comma OR any space(s)
      .map((e) => e.trim())
      .filter((e) => e !== "");
    const foremanName = (foreman || "").toString().trim();

    // Skip any row with missing names (prevents "Unknown")
    if (empNames.length === 0 || !foremanName) continue;

    const isToday = date.toDateString() === todayStr;
    const isThisMonth =
      date.getMonth() === month && date.getFullYear() === year;
    const isCompanyJob = companyName !== "";

    if (!foremanMap[foremanName]) {
      foremanMap[foremanName] = {
        daily: 0,
        monthly: 0,
        carsToday: 0,
        carsMonth: 0,
      };
    }

    // Zeena, Perfume, Wiper
    const specialServices = ["Zeena", "Perfume", "Wipers"];
    if (specialServices.includes(service)) {
      if (!zeenahMap[service])
        zeenahMap[service] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      if (isToday) {
        zeenahMap[service].dailyCars++;
        zeenahMap[service].dailyAmt += serviceAmt;
      }
      if (isThisMonth) {
        zeenahMap[service].monthlyCars++;
        zeenahMap[service].monthlyAmt += serviceAmt;
      }
    }

    // Company
    if (isCompanyJob) {
      if (!companyMap[companyName]) {
        companyMap[companyName] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      }
      if (isToday) {
        companyMap[companyName].dailyAmt += actualAmt;
        companyMap[companyName].dailyCars++;
      }
      if (isThisMonth) {
        companyMap[companyName].monthlyAmt += actualAmt;
        companyMap[companyName].monthlyCars++;
      }
    }

    // Oil
    if (oilChange && oilChange.toString().trim() !== "") {
      if (!oilMap[oilChange])
        oilMap[oilChange] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      if (isToday) {
        oilMap[oilChange].dailyAmt += serviceAmt;
        oilMap[oilChange].dailyCars++;
      }
      if (isThisMonth) {
        oilMap[oilChange].monthlyAmt += serviceAmt;
        oilMap[oilChange].monthlyCars++;
      }
    }

    // Employee (include all)
    const splitAmt = serviceAmt / empNames.length;
    empNames.forEach((name) => {
      if (!empMap[name])
        empMap[name] = { daily: 0, monthly: 0, carsToday: 0, carsMonth: 0 };

      if (isToday) {
        empMap[name].daily += splitAmt;
        empMap[name].carsToday++;

        // Track last job timestamp today
        if (!empLastWorkToday[name] || date > empLastWorkToday[name]) {
          empLastWorkToday[name] = date;
        }
      }

      if (isThisMonth) {
        empMap[name].monthly += splitAmt;
        empMap[name].carsMonth++;
      }
    });

    // Foreman (exclude company)
    if (!isCompanyJob) {
      if (isToday) {
        foremanMap[foremanName].daily += serviceAmt;
        foremanMap[foremanName].carsToday++;
      }
      if (isThisMonth) {
        foremanMap[foremanName].monthly += serviceAmt;
        foremanMap[foremanName].carsMonth++;
      }
    }

    // Totals

    if (isToday) {
      if (isCompanyJob) {
        carsTodayIncl++;
        totalTodayIncl += actualAmt;
      } else {
        carsTodayIncl++;
        carsTodayExcl++;
        totalTodayIncl += actualAmt;
        totalTodayExcl += actualAmt;
      }
    }

    if (isThisMonth) {
      if (isCompanyJob) {
        carsMonthIncl++;
        totalMonthIncl += actualAmt;
      } else {
        carsMonthIncl++;
        carsMonthExcl++;
        totalMonthIncl += actualAmt;
        totalMonthExcl += actualAmt;
      }
    }
  }

  // Clear output
  clearReportRenderArea(sheet);

  const formatMoney = (amt) => `AED ${amt.toLocaleString("en-US")}`;
  let currentRow = 2;

  // HEADER
  sheet
    .getRange(currentRow, REPORT_START_COLUMN, 1, REPORT_COLUMN_COUNT)
    .merge()
    .setValue("AL RAKED EARNINGS REPORT")
    .setFontWeight("bold")
    .setFontSize(REPORT_FONT_SIZE.TITLE)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setHorizontalAlignment("center");
  currentRow++;
  sheet
    .getRange(currentRow, REPORT_START_COLUMN, 1, REPORT_COLUMN_COUNT)
    .merge()
    .setValue(formatReportTimestamp(new Date()))
    .setFontSize(REPORT_FONT_SIZE.TIMESTAMP)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setHorizontalAlignment("center");
  currentRow += 2;

  // SUMMARY HEADING
  sheet
    .getRange(currentRow, REPORT_START_COLUMN, 1, REPORT_COLUMN_COUNT)
    .merge()
    .setValue("DAILY & MONTHLY SUMMARY")
    .setFontWeight("bold")
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_TITLE)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setHorizontalAlignment("center");
  currentRow++;

  // Subheadings for two distinct tables
  sheet
    .getRange(currentRow, REPORT_START_COLUMN, 1, 2)
    .merge()
    .setValue("WITHOUT COMPANY")
    .setFontWeight("bold")
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TABLE_HEADER)
    .setHorizontalAlignment("center");
  sheet
    .getRange(currentRow, REPORT_START_COLUMN + 3, 1, 2)
    .merge()
    .setValue("WITH COMPANY")
    .setFontWeight("bold")
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TABLE_HEADER)
    .setHorizontalAlignment("center");
  currentRow++;

  const summaryDataExcl = [
    ["Today", formatMoney(totalTodayExcl)],
    ["Cars Today", carsTodayExcl],
    ["This Month", formatMoney(totalMonthExcl)],
    ["Cars This Month", carsMonthExcl],
  ];
  const summaryDataIncl = [
    ["Today", formatMoney(totalTodayIncl)],
    ["Cars Today", carsTodayIncl],
    ["This Month", formatMoney(totalMonthIncl)],
    ["Cars This Month", carsMonthIncl],
  ];

  // Left table
  const exclRange = sheet.getRange(
    currentRow,
    REPORT_START_COLUMN,
    summaryDataExcl.length,
    2,
  );
  exclRange
    .setValues(summaryDataExcl)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setBackgrounds(
      buildAlternatingReportBackgrounds(summaryDataExcl.length, 2),
    );
  exclRange.setBorder(true, true, true, true, true, true);
  exclRange.setHorizontalAlignment("right");
  sheet
    .getRange(currentRow, REPORT_START_COLUMN, summaryDataExcl.length, 1)
    .setFontWeight("bold")
    .setHorizontalAlignment("left")
    .setWrap(true)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_LABEL);

  // Right table
  const inclRange = sheet.getRange(
    currentRow,
    REPORT_START_COLUMN + 3,
    summaryDataIncl.length,
    2,
  );
  inclRange
    .setValues(summaryDataIncl)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setBackgrounds(
      buildAlternatingReportBackgrounds(summaryDataIncl.length, 2),
    );
  inclRange.setBorder(true, true, true, true, true, true);
  inclRange.setHorizontalAlignment("right");
  sheet
    .getRange(currentRow, REPORT_START_COLUMN + 3, summaryDataIncl.length, 1)
    .setFontWeight("bold")
    .setHorizontalAlignment("left")
    .setWrap(true)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_LABEL);

  // FORMAT SUMMARY VALUES

  sheet
    .getRange(currentRow, REPORT_START_COLUMN + 1, summaryDataExcl.length, 1)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_VALUE)
    .setFontWeight("bold")
    .setHorizontalAlignment("right");

  sheet
    .getRange(currentRow, REPORT_START_COLUMN + 4, summaryDataIncl.length, 1)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.SUMMARY_VALUE)
    .setFontWeight("bold")
    .setHorizontalAlignment("right");

  currentRow += summaryDataExcl.length + 2;

  // Generic table function
  function writeTable(title, headers, rows, leftAlignCols = [0]) {
    sheet
      .getRange(currentRow, REPORT_START_COLUMN, 1, headers.length)
      .merge()
      .setValue(title)
      .setFontWeight("bold")
      .setFontSize(REPORT_FONT_SIZE.SECTION_TITLE)
      .setFontFamily(REPORT_FONT_FAMILY)
      .setHorizontalAlignment("center");
    currentRow++;
    sheet
      .getRange(currentRow, REPORT_START_COLUMN, 1, headers.length)
      .setValues([headers])
      .setFontWeight("bold")
      .setFontFamily(REPORT_FONT_FAMILY)
      .setFontSize(REPORT_FONT_SIZE.TABLE_HEADER);
    currentRow++;
    if (rows.length) {
      const range = sheet.getRange(
        currentRow,
        REPORT_START_COLUMN,
        rows.length,
        headers.length,
      );

      range
        .setValues(rows)
        .setFontFamily(REPORT_FONT_FAMILY)
        .setFontSize(REPORT_FONT_SIZE.TABLE_BODY)
        .setBackgrounds(
          buildAlternatingReportBackgrounds(rows.length, headers.length),
        )
        .setWrap(true);

      range.setBorder(true, true, true, true, true, true);

      // Alignment
      range.setHorizontalAlignment("right");
      leftAlignCols.forEach((c) => {
        const range = sheet.getRange(
          currentRow,
          REPORT_START_COLUMN + c,
          rows.length,
          1,
        );
        range.setHorizontalAlignment("left");
        range.setFontWeight("bold");
      });

      currentRow += rows.length + 2;
    } else {
      currentRow += 2;
    }
  }

  // Top Performer (by cars washed this month)
  let topEmp = "",
    topCars = 0;
  for (let emp in empMap) {
    if (empMap[emp].carsMonth > topCars) {
      topCars = empMap[emp].carsMonth;
      topEmp = emp;
    }
  }
  sheet
    .getRange(currentRow, REPORT_START_COLUMN, 1, REPORT_COLUMN_COUNT)
    .merge()
    .setValue(`Top Performer This Month: ${topEmp} (${topCars} VEHICLES)`)
    .setFontWeight("bold")
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.HIGHLIGHT)
    .setHorizontalAlignment("center");
  currentRow += 2;

  // Employee
  const empList = Object.keys(empMap).sort(
    (a, b) => empMap[b].carsToday - empMap[a].carsToday,
  );
  const now = new Date();
  const inactiveEmployeeRows = [];

  const empRows = empList.map((name) => {
    let lastWorkText = "No work today";
    let inactiveOverThirtyMinutes = false;

    if (empLastWorkToday[name]) {
      const last = empLastWorkToday[name];
      const diffMinutes = Math.floor((now - last) / 60000);
      inactiveOverThirtyMinutes = diffMinutes > 30;
      const time = Utilities.formatDate(
        last,
        Session.getScriptTimeZone(),
        "HH:mm",
      );

      let timeText;

      if (diffMinutes >= 60) {
        const hours = Math.floor(diffMinutes / 60);
        const mins = diffMinutes % 60;
        timeText = mins ? `${hours}h ${mins}m` : `${hours}h`;
      } else {
        timeText = `${diffMinutes}m`;
      }

      lastWorkText = `${timeText} ago (${time})`;
    }

    inactiveEmployeeRows.push(inactiveOverThirtyMinutes);

    return [
      name,
      lastWorkText,
      formatMoney(empMap[name].daily),
      empMap[name].carsToday,
      formatMoney(empMap[name].monthly),
      empMap[name].carsMonth,
    ];
  });

  const employeeDataStartRow = currentRow + 2;
  writeTable(
    "EMPLOYEE PERFORMANCE",
    [
      "NAME",
      "LAST WORKED",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    empRows,
    [0, 1],
  );

  const inactiveStatusColumn = getA1ColumnLetter(REPORT_START_COLUMN + 1);
  const inactiveStatusCells = inactiveEmployeeRows
    .map((isInactive, index) =>
      isInactive
        ? `${inactiveStatusColumn}${employeeDataStartRow + index}`
        : null,
    )
    .filter(Boolean);

  if (inactiveStatusCells.length) {
    sheet.getRangeList(inactiveStatusCells).setBackground("#f4cccc");
  }

  // Foreman
  const foremanList = Object.keys(foremanMap).sort(
    (a, b) => foremanMap[b].daily - foremanMap[a].daily,
  );
  const foremanRows = foremanList.map((name) => [
    name,
    formatMoney(foremanMap[name].daily),
    foremanMap[name].carsToday,
    formatMoney(foremanMap[name].monthly),
    foremanMap[name].carsMonth,
  ]);
  writeTable(
    "FOREMAN PERFORMANCE",
    [
      "NAME",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    foremanRows,
  );

  // Company
  const compList = Object.keys(companyMap);
  const compRows = compList.map((name) => [
    name,
    formatMoney(companyMap[name].dailyAmt),
    companyMap[name].dailyCars,
    formatMoney(companyMap[name].monthlyAmt),
    companyMap[name].monthlyCars,
  ]);
  writeTable(
    "COMPANY JOBS",
    [
      "COMPANY",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    compRows,
  );
  // Zeena services and oil-change details share one summary table.
  const zeenaOilRows = buildZeenaOilRows(zeenahMap, oilMap, formatMoney);
  writeTable(
    "ZEENA / OIL SERVICE",
    [
      "SERVICE / OIL TYPE",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    zeenaOilRows,
    [0],
  );

  if (zeenaOilRows.length) {
    sheet
      .getRange(
        currentRow - zeenaOilRows.length - 2,
        REPORT_START_COLUMN,
        zeenaOilRows.length,
        1,
      )
      .setWrap(true);
  }

  // Preserve the original per-type oil breakdown below the summary.
  const oilDetailRows = buildOilDetailRows(oilMap, formatMoney);
  writeTable(
    "OIL CHANGE",
    [
      "OIL TYPE",
      "EARNINGS TODAY",
      "CARS TODAY",
      "EARNINGS THIS MONTH",
      "CARS THIS MONTH",
    ],
    oilDetailRows,
    [0],
  );

  if (oilDetailRows.length) {
    sheet
      .getRange(
        currentRow - oilDetailRows.length - 2,
        REPORT_START_COLUMN,
        oilDetailRows.length,
        1,
      )
      .setWrap(true);
  }

  // Detailed company logs. Company names are discovered from the form data.
  Object.keys(companyJobs)
    .sort((a, b) => a.localeCompare(b))
    .forEach((companyName) => {
      const companyRows = companyJobs[companyName].map((row) => {
        const date = row[0] ? new Date(row[0]) : "";
        const price = parseFloat(row[5]) || 0;
        const formattedPrice = `AED ${price.toLocaleString("en-US")}`;
        return [date, row[3], row[4], formattedPrice, row[6], row[8]];
        // columns: Date, License Plate, Service, Price, Company, Detail
      });

      writeTable(
        `${companyName.toUpperCase()} VEHICLE LOG`,
        ["DATE", "LICENSE PLATE", "SERVICE", "PRICE", "COMPANY", "DETAIL"],
        companyRows,
      );

      // Adjust alignment and bold manually after writing
      const startRow = currentRow - companyRows.length - 2;
      const sheetRange = sheet.getRange(
        startRow,
        REPORT_START_COLUMN,
        companyRows.length,
        REPORT_COLUMN_COUNT,
      );

      sheet
        .getRange(startRow, REPORT_START_COLUMN, companyRows.length, 1)
        .setNumberFormat("dd/MM/yy");

      sheetRange.setFontWeight("bold");

      for (let c = 0; c < 6; c++) {
        const colRange = sheet.getRange(
          startRow,
          REPORT_START_COLUMN + c,
          companyRows.length,
          1,
        );
        if (c === 1) colRange.setHorizontalAlignment("center");
        else if (c === 3) colRange.setHorizontalAlignment("right");
        else colRange.setHorizontalAlignment("left");
      }
      sheet
        .getRange(
          startRow,
          REPORT_START_COLUMN + REPORT_COLUMN_COUNT - 1,
          companyRows.length,
          1,
        )
        .setWrap(true);
    });

  updateReportCache();
}

function auditPriceChange(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(5000); // wait up to 5 seconds for previous edit to finish

  try {
    const MAIN = "Form Responses 1";
    const AUDIT = "PriceAudit";

    const SERVICE_COL = 5;
    const PRICE_COL = 6;
    const MERGE_WINDOW_MINUTES = 30;

    const sheet = e.range.getSheet();
    if (sheet.getName() !== MAIN) return;

    const row = e.range.getRow();
    const col = e.range.getColumn();

    if (row === 1) return;
    if (col !== SERVICE_COL && col !== PRICE_COL) return;

    if (col === SERVICE_COL && e.oldValue === e.value) return;
    if (col === PRICE_COL && e.oldValue === e.value) return;

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const audit = ss.getSheetByName(AUDIT);

    const rowData = sheet.getRange(row, 1, 1, 10).getValues()[0];

    const timestamp = rowData[0];
    const entryForeman = rowData[1];
    const employee = rowData[2];
    const license = rowData[3];

    const service = rowData[4];
    const price = rowData[5];

    const changeTime = new Date();

    // Re-locate the correct row in case sorting moved it
    const allData = getFormResponseData(sheet);
    let correctRow = row;

    for (let i = 1; i < allData.length; i++) {
      const t = allData[i][0];
      const plate = allData[i][3];

      if (
        new Date(t).getTime() === new Date(timestamp).getTime() &&
        plate === license
      ) {
        correctRow = i + 1;
        break;
      }
    }

    // Highlight correct row even if sheet sorted
    sheet.getRange(correctRow, col).setBackground("#f7c6c6");
    SpreadsheetApp.flush();

    let oldService = service;
    let newService = service;

    let oldPrice = price;
    let newPrice = price;

    if (col === SERVICE_COL) {
      if (typeof e.oldValue !== "undefined") {
        oldService = e.oldValue;
      } else if (existingRow) {
        oldService = audit.getRange(existingRow, 5).getValue();
      } else {
        oldService = service;
      }

      newService = service;
    }

    if (col === PRICE_COL) {
      if (typeof e.oldValue === "undefined") return;

      oldPrice = e.oldValue;
      newPrice = price;
    }

    const data = getFormResponseData(sheet);
    let activeForeman = entryForeman;

    for (let i = 1; i < data.length; i++) {
      const t = new Date(data[i][0]);

      if (t <= changeTime) {
        activeForeman = data[i][1];
      } else {
        break;
      }
    }

    const lastRow = audit.getLastRow();

    let existingRow = null;

    if (lastRow >= 2) {
      const newest = audit.getRange(2, 1, 1, 10).getValues()[0];

      const logTimestamp = new Date(newest[1]).getTime();
      const logPlate = newest[2];
      const previousChangeTime = new Date(newest[0]).getTime();

      const sameJob =
        logTimestamp === new Date(timestamp).getTime() && logPlate === license;

      const minutesSinceLastChange =
        (changeTime.getTime() - previousChangeTime) / 60000;

      if (sameJob && minutesSinceLastChange <= MERGE_WINDOW_MINUTES) {
        existingRow = 2;
      }
    }

    const values = [
      changeTime,
      timestamp,
      license,
      oldService,
      newService,
      employee,
      entryForeman,
      oldPrice,
      newPrice,
      activeForeman,
    ];

    if (existingRow) {
      const prev = audit.getRange(existingRow, 1, 1, 10).getValues()[0];

      let finalOldService = prev[3];
      let finalNewService = prev[4];
      let finalOldPrice = prev[7];
      let finalNewPrice = prev[8];

      if (col === SERVICE_COL) {
        finalOldService = prev[3] || oldService;
        finalNewService = newService;
      }

      if (col === PRICE_COL) {
        finalOldPrice = prev[7] || oldPrice;
        finalNewPrice = newPrice;
      }

      const mergedValues = [
        changeTime,
        timestamp,
        license,
        finalOldService,
        finalNewService,
        employee,
        entryForeman,
        finalOldPrice,
        finalNewPrice,
        activeForeman,
      ];

      audit.getRange(existingRow, 1, 1, 10).setValues([mergedValues]);
    } else {
      audit.insertRowAfter(1);

      const newRow = 2;

      audit.getRange(newRow, 1, 1, 10).setValues([values]);

      SpreadsheetApp.flush();

      // Copy formatting template from Row 1 (K–T) → new row (A–J)
      audit
        .getRange(1, 11, 1, 10)
        .copyTo(audit.getRange(newRow, 1, 1, 10), { formatOnly: true });

      audit.getRange(newRow, 1, 1, 10).setFontColor("black");
    }

    if (audit.getLastRow() > 2) {
      audit
        .getRange(2, 1, audit.getLastRow() - 1, 10)
        .sort({ column: 1, ascending: false });
    }
  } finally {
    lock.releaseLock();
  }
}

