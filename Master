function duplicateSheetAtMonthEnd() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sourceSheet = ss.getSheetByName("Form Responses 1");
  if (!sourceSheet) return;

  const now = new Date();
  const year = now.getFullYear();
  const month = now.getMonth();

  // Check if today is the last day of the month
  const tomorrow = new Date(year, month, now.getDate() + 1);
  if (tomorrow.getMonth() !== month) {
    // Today is last day of month
    const shortMonth = Utilities.formatDate(
      now,
      Session.getScriptTimeZone(),
      "MMM",
    );

    const shortYear = Utilities.formatDate(
      now,
      Session.getScriptTimeZone(),
      "yy",
    );

    const newName = `${shortMonth}'${shortYear}`;

    // Avoid duplicate copies if script runs again
    if (ss.getSheetByName(newName)) return;

    // ---- DUPLICATE SHEET ----

    const newSheet = sourceSheet.copyTo(ss).setName(newName);

    // ---- MOVE AFTER PriceAudit ----

    const priceAuditSheet = ss.getSheetByName("PriceAudit");

    if (priceAuditSheet) {
      const targetIndex = priceAuditSheet.getIndex();

      ss.setActiveSheet(newSheet);

      ss.moveActiveSheet(targetIndex + 1);
    }

    // ---- PROTECT SHEET ----

    const protection = newSheet
      .protect()
      .setDescription("Locked monthly archive");

    const me = Session.getEffectiveUser();

    // Remove everyone except you

    protection.removeEditors(
      protection
        .getEditors()
        .filter((user) => user.getEmail() !== me.getEmail()),
    );

    // Ensure you are added

    protection.addEditor(me);

    // Disable domain editing

    if (protection.canDomainEdit()) {
      protection.setDomainEdit(false);
    }
  }
}

