function getAllEmployeesList() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sheets = ss.getSheets();

  const employees = {};

  sheets.forEach((sheet) => {
    const sheetName = sheet.getName();

    // Skip utility sheets
    if (sheetName === "PriceAudit" || sheetName.startsWith("TEMP")) {
      return;
    }

    const data = getDataSheetValues(sheet);

    if (data.length < 2) return;

    const headers = data[0].map((h) => h.toString().trim().toLowerCase());

    // Find employee column dynamically
    const employeeCol = headers.findIndex((h) => h.includes("employee"));

    if (employeeCol === -1) return;

    for (let i = 1; i < data.length; i++) {
      const employeeCell = data[i][employeeCol];

      if (!employeeCell) continue;

      const names = employeeCell
        .toString()
        .split(/,|\s+/)
        .map((e) => e.trim().toUpperCase())
        .filter(Boolean);

      names.forEach((name) => {
        employees[name] = true;
      });
    }
  });

  return Object.keys(employees).sort();
}

