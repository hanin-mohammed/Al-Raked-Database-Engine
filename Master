function getMonthlyCompanyLogs(referenceDate) {
  const sheet =
    SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1");
  const data = getFormResponseData(sheet);
  const targetMonth = referenceDate.getMonth();
  const targetYear = referenceDate.getFullYear();
  const companyLogs = {};

  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const timestamp = row[0];
    const companyName = (row[6] || "").toString().trim();

    if (!timestamp || !companyName) continue;

    const date = new Date(timestamp);
    if (date.getMonth() !== targetMonth || date.getFullYear() !== targetYear) {
      continue;
    }

    let serviceAmount = 0;
    if (row[5] && row[5].toString().trim().toLowerCase() !== "free") {
      serviceAmount = parseFloat(row[5]) || 0;
    }

    const specialPrice = row[9];
    const actualAmount =
      specialPrice !== "" &&
      specialPrice !== null &&
      specialPrice !== undefined
        ? parseFloat(specialPrice) || 0
        : serviceAmount;

    if (!companyLogs[companyName]) companyLogs[companyName] = [];

    companyLogs[companyName].push([
      date,
      row[3] || "",
      row[4] || "",
      actualAmount,
      companyName,
      row[8] || "",
    ]);
  }

  Object.keys(companyLogs).forEach((companyName) => {
    companyLogs[companyName].sort((a, b) => b[0] - a[0]);
  });

  return companyLogs;
}

function safeFilePart(value) {
  return value
    .toString()
    .trim()
    .replace(/[\\/:*?"<>|]+/g, "_")
    .replace(/\s+/g, "_")
    .replace(/_+/g, "_")
    .replace(/^_+|_+$/g, "");
}

function formatCompanyExportSheet(exportSheet, rows) {
  const headers = [[
    "DATE",
    "LICENSE PLATE",
    "SERVICE",
    "PRICE",
    "COMPANY",
    "DETAIL",
  ]];

  exportSheet.getRange(1, 1, 1, 6).setValues(headers);
  if (rows.length) exportSheet.getRange(2, 1, rows.length, 6).setValues(rows);

  const totalRow = rows.length + 2;
  const totalAmount = rows.reduce((sum, row) => sum + (Number(row[3]) || 0), 0);
  exportSheet.getRange(totalRow, 3, 1, 2).setValues([["TOTAL", totalAmount]]);

  exportSheet
    .getRange(1, 1, totalRow, 6)
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TABLE_BODY);

  exportSheet.setFrozenRows(1);
  exportSheet.setColumnWidth(1, 120);
  exportSheet.setColumnWidth(2, 150);
  exportSheet.setColumnWidth(3, 160);
  exportSheet.setColumnWidth(4, 120);
  exportSheet.setColumnWidth(5, 180);
  exportSheet.setColumnWidth(6, 320);

  exportSheet
    .getRange(1, 1, 1, 6)
    .setFontWeight("bold")
    .setFontColor("white")
    .setBackground("#222222")
    .setFontSize(REPORT_FONT_SIZE.TABLE_HEADER)
    .setHorizontalAlignment("center");

  if (rows.length) {
    exportSheet.getRange(2, 1, rows.length, 1).setNumberFormat("dd/MM/yy");
    exportSheet
      .getRange(2, 4, rows.length, 1)
      .setNumberFormat('"AED" #,##0.00');
  }

  exportSheet
    .getRange(totalRow, 3, 1, 2)
    .setFontWeight("bold")
    .setBackground("#D9EAD3");
  exportSheet.getRange(totalRow, 4).setNumberFormat('"AED" #,##0.00');

  exportSheet.getRange("A:B").setHorizontalAlignment("center");
  exportSheet.getRange("C:C").setHorizontalAlignment("left");
  exportSheet.getRange("D:D").setHorizontalAlignment("right");
  exportSheet.getRange("E:F").setHorizontalAlignment("left");
  exportSheet.getRange("F:F").setWrap(true);
}

function emailMonthlyReport(skipCalc) {
  const today = new Date();
  const tomorrow = new Date(
    today.getFullYear(),
    today.getMonth(),
    today.getDate() + 1,
  );

  if (tomorrow.getMonth() === today.getMonth()) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Form Responses 1");
  const tz = Session.getScriptTimeZone();
  const monthName = Utilities.formatDate(today, tz, "MMMM yyyy");
  const fileDate = Utilities.formatDate(today, tz, "MMMM_yyyy");
  const reportSheetName = "TEMP_MONTHLY_REPORT";
  const temporarySpreadsheetIds = [];

  if (!skipCalc) calc();
  SpreadsheetApp.flush();

  try {
    const existingReport = ss.getSheetByName(reportSheetName);
    const legacyLog = ss.getSheetByName("TEMP_PRIVATE_LOG");
    if (existingReport) ss.deleteSheet(existingReport);
    if (legacyLog) ss.deleteSheet(legacyLog);

    const tempReport = ss.insertSheet(reportSheetName);
    const reportLastRow = getLastReportRow(sheet);
    if (tempReport.getMaxRows() < reportLastRow) {
      tempReport.insertRowsAfter(
        tempReport.getMaxRows(),
        reportLastRow - tempReport.getMaxRows(),
      );
    }
    const reportRange = sheet.getRange(
      1,
      REPORT_START_COLUMN,
      reportLastRow,
      REPORT_COLUMN_COUNT,
    );
    reportRange.copyTo(tempReport.getRange("A1"), { contentsOnly: false });

    tempReport.setColumnWidths(1, 6, 140);
    tempReport.setColumnWidth(1, 260);
    tempReport.getRange(1, 1, reportLastRow, 6).setWrap(true);
    tempReport.setFrozenRows(2);
    tempReport.getRange("A2").setValue(`AL RAKED EARNINGS REPORT ${monthName}`);

    // Company detail logs are attached separately as Excel workbooks.
    const reportValues = tempReport.getDataRange().getValues();
    for (let i = 0; i < reportValues.length; i++) {
      const title = (reportValues[i][0] || "").toString().trim();
      if (title.endsWith(" VEHICLE LOG")) {
        tempReport.deleteRows(i + 1, reportValues.length - i);
        break;
      }
    }

    const options = {
      headers: { Authorization: "Bearer " + ScriptApp.getOAuthToken() },
      muteHttpExceptions: true,
    };

    const pdfUrl =
      `https://docs.google.com/spreadsheets/d/${ss.getId()}/export?format=pdf` +
      `&size=A4&portrait=true&fitw=true&sheetnames=false&printtitle=false` +
      `&pagenumbers=false&gridlines=false&fzr=false&gid=${tempReport.getSheetId()}`;
    const pdfResponse = UrlFetchApp.fetch(pdfUrl, options);

    if (pdfResponse.getResponseCode() !== 200) {
      throw new Error("Monthly earnings PDF export failed.");
    }

    const attachments = [
      pdfResponse
        .getBlob()
        .setName(`Al_Raked_Earnings_Report_${fileDate}.pdf`),
    ];

    const companyLogs = getMonthlyCompanyLogs(today);
    const companyNames = Object.keys(companyLogs).sort((a, b) =>
      a.localeCompare(b),
    );

    for (const companyName of companyNames) {
      const safeCompanyName = safeFilePart(companyName);
      const tempSpreadsheet = SpreadsheetApp.create(
        `TEMP_${safeCompanyName}_LOG_EXPORT`,
      );
      temporarySpreadsheetIds.push(tempSpreadsheet.getId());

      const exportSheet = tempSpreadsheet.getSheets()[0];
      exportSheet.setName("Company Log");
      formatCompanyExportSheet(exportSheet, companyLogs[companyName]);
      SpreadsheetApp.flush();

      const xlsxUrl =
        `https://docs.google.com/spreadsheets/d/${tempSpreadsheet.getId()}` +
        `/export?format=xlsx`;
      const xlsxResponse = UrlFetchApp.fetch(xlsxUrl, options);

      if (xlsxResponse.getResponseCode() !== 200) {
        throw new Error(`Excel export failed for ${companyName}.`);
      }

      attachments.push(
        xlsxResponse
          .getBlob()
          .setName(`${safeCompanyName}_Log_${fileDate}.xlsx`),
      );
    }

    const companyListText = companyNames.length
      ? companyNames
          .map((name, index) => `${index + 2}. ${name} vehicle log (Excel)`)
          .join("\n")
      : "2. No company vehicle logs were recorded this month.";

    MailApp.sendEmail({
      to: "imhaninmohd@gmail.com, alrakedcarwashingstation@gmail.com, Humaid.almessabi@gmail.com",
      subject: `Al Raked Monthly Earnings Report - ${monthName}`,
      body:
        "Sir,\n\n" +
        `Monthly consolidation complete for ${monthName}.\n\n` +
        "Included in this transmission:\n" +
        "1. Earnings performance report (PDF)\n" +
        companyListText +
        "\n\nAll data has been structured, validated and archived.\n" +
        "Please review at your convenience.",
      attachments: attachments,
    });
  } finally {
    const reportTab = ss.getSheetByName(reportSheetName);
    if (reportTab) ss.deleteSheet(reportTab);

    temporarySpreadsheetIds.forEach((spreadsheetId) => {
      try {
        DriveApp.getFileById(spreadsheetId).setTrashed(true);
      } catch (cleanupError) {
        Logger.log("Company export cleanup failed: " + cleanupError);
      }
    });
  }
}

function cleanSlateProtocol() {
  const today = new Date();
  const tz = Session.getScriptTimeZone();

  // SAFETY CHECK
  if (today.getDate() !== 1) {
    Logger.log(
      "Clean Slate Protocol aborted: today is not the first of the month.",
    );
    return;
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const formResponseSheet = ss.getSheetByName("Form Responses 1");

  // Capture the closing month's employees before Clean Slate removes its rows.
  preserveClosingMonthEmployeeIndex(formResponseSheet, today, tz);

  const sheetsToReset = ["Form Responses 1", "PriceAudit"];

  let clearedSheets = [];

  sheetsToReset.forEach((name) => {
    const sheet = ss.getSheetByName(name);
    if (!sheet) return;

    const lastRow = sheet.getLastRow();
    const lastCol = sheet.getLastColumn();

    if (name === "Form Responses 1") {
      clearReportRenderArea(sheet);
    }

    if (lastRow > 1) {
      // Clear content
      sheet.getRange(2, 1, lastRow - 1, lastCol).clearContent();

      // Reset background colors (Service + Price columns)
      sheet.getRange(2, 5, lastRow - 1, 1).setBackground(null); // Column E
      sheet.getRange(2, 6, lastRow - 1, 1).setBackground(null); // Column F

      // ---- LIMIT TO 300 ROWS ----
      const MAX_ROWS = 300; // Row 1 header + 299 rows

      if (sheet.getMaxRows() > MAX_ROWS) {
        sheet.deleteRows(MAX_ROWS + 1, sheet.getMaxRows() - MAX_ROWS);
      }

      clearedSheets.push(name);
    }
  });

  SpreadsheetApp.flush();

  // SEND CONFIRMATION EMAIL
  const dateText = Utilities.formatDate(today, tz, "MMMM d, yyyy HH:mm");

  MailApp.sendEmail({
    to: "imhaninmohd@gmail.com, alrakedcarwashingstation@gmail.com",
    subject: "Al Raked Clean Slate Protocol Completed",
    body:
      "Sir,\n\n" +
      "Clean Slate Protocol executed successfully.\n\n" +
      "Timestamp: " +
      dateText +
      "\n\n" +
      "The following systems have been reset:\n" +
      clearedSheets.join("\n") +
      "\n\n" +
      "Structural integrity confirmed. Headers remain intact.\n" +
      "The system is now fully prepared for the new operational cycle.\n\n" +
      "All processes standing by.",
  });
}

