    .setValue("Yesterday + Today Combined")
    .setFontFamily(REPORT_FONT_FAMILY)
    .setFontSize(REPORT_FONT_SIZE.TIMESTAMP)
    .setHorizontalAlignment("center");

  currentRow += 2;

  // -------- SUMMARY (IDENTICAL STRUCTURE) --------
  const summaryDataExcl = [
    ["Today", formatMoney(totalTodayExcl)],
    ["Cars Today", carsTodayExcl],
    ["This Month", formatMoney(totalMonthExcl)],
    ["Cars This Month", carsMonthExcl],
  ];

  const summaryDataIncl = [
    ["Today", formatMoney(totalTodayIncl)],
    ["Cars Today", carsTodayIncl],
    ["This Month", formatMoney(totalMonthIncl)],
    ["Cars This Month", carsMonthIncl],
  ];

  sheet
    .getRange(currentRow, REPORT_START_COLUMN, summaryDataExcl.length, 2)
