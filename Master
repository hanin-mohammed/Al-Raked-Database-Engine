function escapeTextFinderRegex(text) {
  return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function sheetContainsEmployee(sheet, employeeName) {
  const lastRow = getFormResponseLastRow(sheet);
  if (lastRow < 2) return false;

  const employeePattern = `(^|[,\\s])${escapeTextFinderRegex(employeeName)}($|[,\\s])`;

  return Boolean(
    sheet
      .getRange(2, 3, lastRow - 1, 1)
      .createTextFinder(employeePattern)
      .useRegularExpression(true)
      .matchCase(false)
      .findNext(),
  );
}

