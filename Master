function processFormSubmission(submittedRow) {
  const sheet =
    SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1");
  const lastRow = Math.max(
    getFormResponseLastRow(sheet),
    Number(submittedRow) || 1,
  );

  // 1. Sort only the form-data region (A–L), starting from row 2.
  if (lastRow > 1) {
    const sortRange = sheet.getRange(2, 1, lastRow - 1, FORM_DATA_COLUMNS);
    sortRange.sort({ column: 1, ascending: false });
  }

  // 2. Reapply the template to the three newest rows. If an earlier trigger
  // failed before formatting, the next successful submission repairs it.

