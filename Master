function calc() {
  const sheet =
    SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Form Responses 1");
  const data = sheet.getDataRange().getValues();
  const today = new Date();
  const todayStr = today.toDateString();
  const month = today.getMonth();
  const year = today.getFullYear();
  const zeenahMap = {};

  const empMap = {};
  const empLastWorkToday = {};
  const foremanMap = {};
  const companyMap = {};
  const oilMap = {};

  let totalTodayIncl = 0,
    totalMonthIncl = 0;
  let totalTodayExcl = 0,
    totalMonthExcl = 0;
  let carsTodayIncl = 0,
    carsMonthIncl = 0;
  let carsTodayExcl = 0,
    carsMonthExcl = 0;
  let enterpriseJobs = [];

  for (let i = 1; i < data.length; i++) {
    const [
      timestamp,
      foreman,
      employee,
      licensePlate,
      service,
      serviceFee,
      company,
      oilChange,
      companyDetail,
      specialPrice,
    ] = data[i];
    if (!timestamp) continue;
    let serviceAmt = 0;
    if (serviceFee && serviceFee.toString().trim().toLowerCase() !== "free") {
      serviceAmt = parseFloat(serviceFee) || 0;
    }

    let actualAmt;
    if (
      specialPrice !== "" &&
      specialPrice !== null &&
      specialPrice !== undefined
    ) {
      actualAmt = parseFloat(specialPrice) || 0; // if 0 entered, that's still valid
    } else {
      actualAmt = serviceAmt; // fallback to service fee if no special price
    }

    if (
      (companyDetail && companyDetail.toString().trim() !== "") ||
      (company && company.toString().trim() === "Private Office")
    ) {
      enterpriseJobs.push([
        timestamp,
        foreman,
        employee,
        licensePlate,
        service,
        actualAmt,
        company,
        oilChange,
        companyDetail,
      ]);
    }

    // Skip blank rows completely
    const date = new Date(timestamp);

    const empNames = (employee || "")
      .toString()
      .split(/,|\s+/) // split by comma OR any space(s)
      .map((e) => e.trim())
      .filter((e) => e !== "");
    const foremanName = (foreman || "").toString().trim();

    // Skip any row with missing names (prevents "Unknown")
    if (empNames.length === 0 || !foremanName) continue;

    const isToday = date.toDateString() === todayStr;
    const isThisMonth =
      date.getMonth() === month && date.getFullYear() === year;
    const isCompanyJob = company && company.toString().trim() !== "";

    if (!foremanMap[foremanName]) {
      foremanMap[foremanName] = {
        daily: 0,
        monthly: 0,
        carsToday: 0,
        carsMonth: 0,
      };
    }

    // Zeena, Perfume, Wiper
    const specialServices = ["Zeena", "Perfume", "Wipers"];
    if (specialServices.includes(service)) {
      if (!zeenahMap[service])
        zeenahMap[service] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      if (isToday) {
        zeenahMap[service].dailyCars++;
        zeenahMap[service].dailyAmt += serviceAmt;
      }
      if (isThisMonth) {
        zeenahMap[service].monthlyCars++;
        zeenahMap[service].monthlyAmt += serviceAmt;
      }
    }

    // Company
    if (isCompanyJob) {
      if (!companyMap[company]) {
        companyMap[company] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      }
      if (isToday) {
        companyMap[company].dailyAmt += serviceAmt;
        companyMap[company].dailyCars++;
      }
      if (isThisMonth) {
        companyMap[company].monthlyAmt += serviceAmt;
        companyMap[company].monthlyCars++;
      }
    }

    // Oil
    if (oilChange && oilChange.toString().trim() !== "") {
      if (!oilMap[oilChange])
        oilMap[oilChange] = {
          dailyAmt: 0,
          monthlyAmt: 0,
          dailyCars: 0,
          monthlyCars: 0,
        };
      if (isToday) {
        oilMap[oilChange].dailyAmt += serviceAmt;
        oilMap[oilChange].dailyCars++;
      }
      if (isThisMonth) {
        oilMap[oilChange].monthlyAmt += serviceAmt;
        oilMap[oilChange].monthlyCars++;
      }
    }

    // Employee (include all)
    const splitAmt = serviceAmt / empNames.length;
    empNames.forEach((name) => {
      if (!empMap[name])
        empMap[name] = { daily: 0, monthly: 0, carsToday: 0, carsMonth: 0 };

      if (isToday) {
        empMap[name].daily += splitAmt;
        empMap[name].carsToday++;

        // Track last job timestamp today
        if (!empLastWorkToday[name] || date > empLastWorkToday[name]) {
          empLastWorkToday[name] = date;
        }
      }

      if (isThisMonth) {
        empMap[name].monthly += splitAmt;
        empMap[name].carsMonth++;
      }
    });

    // Foreman (exclude company)
    if (!isCompanyJob) {
      if (isToday) {
        foremanMap[foremanName].daily += serviceAmt;
