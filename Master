function saveDailyGraphSnapshot() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let historySheet = ss.getSheetByName("MonthlyHistory");

  if (!historySheet) {
    historySheet = ss.insertSheet("MonthlyHistory");

    historySheet
      .getRange("A1:E1")
      .setValues([["Date", "MonthKey", "Day", "Earnings", "Cars"]]);

    historySheet.hideSheet();
  }

  const cachedReport = PropertiesService.getScriptProperties().getProperty(
    "TELEGRAM_REPORT_CACHE",
  );
  let report = null;

  if (cachedReport) {
    try {
      report = JSON.parse(cachedReport);
    } catch (err) {
      Logger.log("Cached report could not be parsed: " + err);
    }
  }

  if (!report) report = getReportData();

  const earnings = report.summary.today.earnings; // excluding company jobs
  const cars = report.summary.today.cars; // excluding company jobs

  const today = new Date();

  const monthKey = Utilities.formatDate(
    today,
    Session.getScriptTimeZone(),
    "yyyy-MM",
  );

  const dayNumber = today.getDate();

  const lastRow = historySheet.getLastRow();

  if (lastRow > 1) {
    const existingData = historySheet
      .getRange(2, 1, lastRow - 1, 3)
      .getValues();

    for (let i = 0; i < existingData.length; i++) {
      const existingMonth = existingData[i][1];
      const existingDay = existingData[i][2];

      if (existingMonth === monthKey && existingDay === dayNumber) {
        historySheet
          .getRange(i + 2, 1, 1, 5)
          .setValues([[today, monthKey, dayNumber, earnings, cars]]);

        return;
      }
    }
  }

  historySheet.appendRow([today, monthKey, dayNumber, earnings, cars]);
}

