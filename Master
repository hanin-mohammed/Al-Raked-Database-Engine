function refreshReportTimestamp() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(
    "Form Responses 1",
  );

  if (!sheet) return;

  // Do not overwrite row 3 while a different report is temporarily rendered.
  const reportTitle = sheet
    .getRange(2, REPORT_START_COLUMN)
    .getDisplayValue();
  if (reportTitle !== "AL RAKED EARNINGS REPORT") return;

  // N3 is the existing merged timestamp cell. Updating it does not rebuild the
  // report, recalculate earnings, or alter the dashboard/API payload.
  sheet
    .getRange(3, REPORT_START_COLUMN)
    .setValue(formatReportTimestamp(new Date()));
  SpreadsheetApp.flush();
}

