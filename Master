function getEmployeeMonthlyPerformance(employeeName, monthKey) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = Session.getScriptTimeZone();
  const currentMonthKey = Utilities.formatDate(new Date(), tz, "yyyy-MM");
  let selectedSheet = null;

  if (monthKey === currentMonthKey) {
    selectedSheet = ss.getSheetByName("Form Responses 1");
  } else {
    const monthMatch = /^(\d{4})-(\d{2})$/.exec(monthKey || "");

    if (monthMatch) {
      const sheets = ss.getSheets();

      for (let i = 0; i < sheets.length; i++) {
        const archiveDetails = getArchiveMonthDetails(sheets[i].getName());

        if (archiveDetails && archiveDetails.monthKey === monthKey) {
          selectedSheet = sheets[i];
          break;
        }
      }
    }
  }

  const sheets = selectedSheet ? [selectedSheet] : [];

  let totalCars = 0;
  let totalEarnings = 0;

  let firstDate = null;
  let lastDate = null;

  const workedDays = {};

  // Detailed sections used by the Al Raked dashboard employee lookup.
  const companies = {};
  const services = {};
  let oilCars = 0;
  let oilEarnings = 0;

  sheets.forEach((sheet) => {
    const data = getFormResponseData(sheet);

    if (data.length < 2) return;

    for (let i = 1; i < data.length; i++) {
      const row = data[i];

      const timestamp = row[0];

      const employeeCell = row[2];

      if (!timestamp || !employeeCell) continue;

      const names = employeeCell
        .toString()
        .split(/,|\s+/)
        .map((e) => e.trim().toUpperCase());

      if (!names.includes(employeeName.toUpperCase())) continue;

      const date = new Date(timestamp);

      const rowMonth = Utilities.formatDate(
        date,
        Session.getScriptTimeZone(),
        "yyyy-MM",
      );

      if (rowMonth !== monthKey) continue;

      // Match main report logic exactly

      const serviceFeeRaw = row[5] !== undefined ? row[5] : 0;

      const specialPriceRaw = row[9] !== undefined ? row[9] : "";

      let serviceAmt = 0;

      if (
        serviceFeeRaw &&
        serviceFeeRaw.toString().trim().toLowerCase() !== "free"
      ) {
        serviceAmt = parseFloat(serviceFeeRaw) || 0;
      }

      let actualAmt = 0;

      if (
        specialPriceRaw !== "" &&
        specialPriceRaw !== null &&
        specialPriceRaw !== undefined
      ) {
        actualAmt = parseFloat(specialPriceRaw) || 0;
      } else {
        actualAmt = serviceAmt;
      }

      // Split between employees
      const splitAmt = actualAmt / names.length;

      totalCars++;
      totalEarnings += splitAmt;

      const dayKey = Utilities.formatDate(
        date,
        Session.getScriptTimeZone(),
        "yyyy-MM-dd",
      );

      workedDays[dayKey] = true;

      const companyName = (row[6] || "").toString().trim();
      if (companyName) {
        if (!companies[companyName]) {
          companies[companyName] = { cars: 0, earnings: 0 };
        }
        companies[companyName].cars++;
        companies[companyName].earnings += splitAmt;
      }

      const oilName = (row[7] || "").toString().trim();
      if (oilName) {
        oilCars++;
        oilEarnings += splitAmt;
      }

      const serviceList = (row[4] || "")
        .toString()
        .split(/\s*,\s*/)
        .map((serviceName) => serviceName.trim().replace(/\s+/g, " "))
        .filter(Boolean);
      const serviceShare = serviceList.length > 0
        ? splitAmt / serviceList.length
        : splitAmt;

      serviceList.forEach((serviceName) => {
        const displayName = serviceName
          .toLowerCase()
          .replace(/\b\w/g, (character) => character.toUpperCase());
        if (!services[displayName]) {
          services[displayName] = { cars: 0, earnings: 0 };
        }
        services[displayName].cars++;
        services[displayName].earnings += serviceShare;
      });

      if (!firstDate || date < firstDate) {
        firstDate = date;
      }

      if (!lastDate || date > lastDate) {
        lastDate = date;
      }
    }
  });

  const daysWorked = Object.keys(workedDays).length;

  if (oilCars > 0 || oilEarnings > 0) {
    const existingOil = services.Oil || { cars: 0, earnings: 0 };
    services.Oil = {
      cars: existingOil.cars + oilCars,
      earnings: existingOil.earnings + oilEarnings,
    };
  }

  return {
    employee: employeeName,
    month: monthKey,

    totalCars: totalCars,

    totalEarnings: totalEarnings,

    daysWorked: daysWorked,

    averageCarsPerDay: daysWorked > 0 ? totalCars / daysWorked : 0,

    averageEarningsPerDay: daysWorked > 0 ? totalEarnings / daysWorked : 0,

    companies: companies,

    services: services,

    firstWork: firstDate
      ? Utilities.formatDate(
          firstDate,
          Session.getScriptTimeZone(),
          "dd MMM yyyy",
        )
      : null,

    lastWork: lastDate
      ? Utilities.formatDate(
          lastDate,
          Session.getScriptTimeZone(),
          "dd MMM yyyy",
        )
      : null,
  };
}
