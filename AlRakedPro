function sendMessage(chatId, text) {

  const url =
    `https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`;

  UrlFetchApp.fetch(url, {

    method: "post",

    contentType:
      "application/json",

    payload: JSON.stringify({

      chat_id: chatId,

      text: text,

      parse_mode: "HTML"

    })

  });

}

function sendLongMessage(chatId, text) {

  const limit = 3500;

  for (
    let i = 0;
    i < text.length;
    i += limit
  ) {

    sendMessage(
      chatId,
      text.substring(i, i + limit)
    );

  }

}
