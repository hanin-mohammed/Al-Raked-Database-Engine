function doPost(e) {

  try {

    const data = JSON.parse(e.postData.contents);

    if (
      !data ||
      !data.message ||
      !data.message.text
    ) {

      return HtmlService.createHtmlOutput("ok");

    }

    const chatId =
      data.message.chat.id;

    const text =
      data.message.text
        .toLowerCase()
        .trim();

    if (text === "/today") {

      sendToday(chatId);

    }

    else if (text === "/employees") {

      sendEmployees(chatId);

    }

    else if (text === "/oils") {

      sendOils(chatId);

    }

    else if (text === "/zeena") {

      sendZeena(chatId);

    }

    else if (text === "/ping") {

      sendMessage(chatId, "pong");

    }

    else {

      sendMessage(
        chatId,
`
<b>COMMANDS</b>

today
employees
oils
zeena
ping
`
      );

    }

    return HtmlService.createHtmlOutput("ok");

  }

  catch(err) {

    Logger.log(err);

    return HtmlService.createHtmlOutput("error");

  }

}

function fetchData() {

  const url =
    WEB_APP_URL +
    "?key=" +
    SECRET_KEY;

  const response =
    UrlFetchApp.fetch(url);

  return JSON.parse(
    response.getContentText()
  );

}

function sendToday(chatId) {

  const data =
    fetchData();

  const s =
    data.summary;

  const msg =
`
<b>AL RAKED</b>

Today: AED ${s.today.earnings} • ${s.today.cars} cars
Month: AED ${s.month.earnings} • ${s.month.cars} cars

With Company

Today: AED ${s.todayIncl.earnings} • ${s.todayIncl.cars} cars
Month: AED ${s.monthIncl.earnings} • ${s.monthIncl.cars} cars
`;

  sendMessage(chatId, msg);

}

function sendEmployees(chatId) {

  const data =
    fetchData();

  const employees =
    data.employees;

  const lastWork =
    data.lastWork;

  let msg =
    `<b>EMPLOYEES</b>\n\n`;

  const now =
    new Date();

  Object.keys(employees)

    .sort((a,b)=>

      employees[b].carsToday -
      employees[a].carsToday

    )

    .forEach(name => {

      const emp =
        employees[name];

      let lastText =
        "No work";

      if (lastWork[name]) {

        const last =
          new Date(lastWork[name]);

        const diff =
          Math.floor(
            (now - last) / 60000
          );

        if (diff >= 60) {

          const h =
            Math.floor(diff / 60);

          const m =
            diff % 60;

          lastText =
            m
              ? `${h}h ${m}m ago`
              : `${h}h ago`;

        }

        else {

          lastText =
            `${diff}m ago`;

        }

      }

      msg +=
`
<b>${name}</b>

AED ${emp.daily.toFixed(0)} • ${emp.carsToday} cars today
AED ${emp.monthly.toFixed(0)} • ${emp.carsMonth} cars month

${lastText}

`;

    });

  sendLongMessage(chatId, msg);

}

