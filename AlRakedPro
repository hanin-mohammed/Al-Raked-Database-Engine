function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);

    if (!data || !data.message || !data.message.text) {
      return HtmlService.createHtmlOutput("ok");
    }

    const chatId = data.message.chat.id;

    const text = data.message.text.toLowerCase().trim();

    if (text === "/today") {
      sendMessage(chatId, "Query received. Bringing today's operational summary, Sir.");
      sendToday(chatId);

    } else if (text === "/employees") {
      sendMessage(chatId, "Query received. Retrieving employee performance data, Sir.");
      sendEmployees(chatId);

    } else if (text === "/idle") {
      sendMessage(chatId, "Query received. Checking inactive personnel, Sir.");
      sendIdle(chatId);

    } else if (text === "/attendance") {
      sendMessage(chatId, "Query received. Compiling attendance records, Sir.");
      sendAttendance(chatId);

    } else if (text === "/oils") {
      sendMessage(chatId, "Query received. Accessing oil service analytics, Sir.");
      sendOils(chatId);

    } else if (text === "/zeena") {
      sendMessage(chatId, "Query received. Retrieving Zeena and wiper statistics, Sir.");
      sendZeena(chatId);

    } else if (text === "/search") {

      PropertiesService.getScriptProperties().setProperty(
        SEARCH_PREFIX + chatId,
        "waiting",
      );

      sendMessage(chatId, "Send vehicle plate number.");

    } else if (text === "/yesterday") {
      sendMessage(chatId, "Query received. Accessing archived daily report, Sir.");
      sendYesterday(chatId);

    } else if (text === "/companies") {
      sendMessage(chatId, "Query received. Gathering company account statistics, Sir.");
      sendCompanies(chatId);

    } else if (text === "/ping") {
      sendMessage(chatId, "pong");

    } else if (
      PropertiesService.getScriptProperties().getProperty(
        SEARCH_PREFIX + chatId,
      )
    ) {

      PropertiesService.getScriptProperties().deleteProperty(
        SEARCH_PREFIX + chatId,
      );

      sendMessage(chatId, "Plate received. Searching vehicle records, Sir.");
      sendVehicleSearch(chatId, text);

    } else {

      sendMessage(
        chatId,
        "<b>AL RAKED COMMAND CENTRE [ARC]</b>\n\n" +
          "Use the blue <b>Menu</b> button beside the chat box to access all available controls and analytics.\n\n" +
          "<b>مركز تحكم الراكد [ARC]</b>\n\n" +
          "استخدم زر <b>Menu</b> الأزرق بجانب المحادثة للوصول إلى جميع أدوات التحكم والإحصائيات.",
      );
    }

    return HtmlService.createHtmlOutput("ok");

  } catch (err) {

    Logger.log(err);

    return HtmlService.createHtmlOutput("error");
  }
}


function fetchData() {
  const url = WEB_APP_URL + "?key=" + SECRET_KEY;

  const response = UrlFetchApp.fetch(url);

  return JSON.parse(response.getContentText());
}

function fetchVehicleSearch(plate) {
  const url =
    WEB_APP_URL + "?key=" + SECRET_KEY + "&search=" + encodeURIComponent(plate);

  const response = UrlFetchApp.fetch(url);

  return JSON.parse(response.getContentText());
}

