function sendYesterday(chatId) {
  const cache = PropertiesService.getScriptProperties().getProperty(
    "TELEGRAM_YESTERDAY_CACHE",
  );

  if (!cache) {
    sendMessage(chatId, "No yesterday data available.");

    return;
  }

  const data = JSON.parse(cache);

  const s = data.summary;

  const msg = `
<b>YESTERDAY SUMMARY</b>

Today:
AED ${s.today.earnings}
• ${s.today.cars} cars

WITH COMPANY

AED ${s.todayIncl.earnings}
• ${s.todayIncl.cars} cars
`;

  sendMessage(chatId, msg);
}

function sendEmployees(chatId) {
  const data = fetchData();

  const employees = data.employees;

  const lastWork = data.lastWork;

  let msg = `<b>EMPLOYEES</b>\n\n`;

  const now = new Date();

  Object.keys(employees)

    .sort((a, b) => employees[b].carsToday - employees[a].carsToday)

    .forEach((name) => {
      const emp = employees[name];

      let lastText = "No work";

      if (lastWork[name]) {
        const last = new Date(lastWork[name]);

        const diff = Math.floor((now - last) / 60000);

        if (diff >= 60) {
          const h = Math.floor(diff / 60);

          const m = diff % 60;

          lastText = m ? `${h}h ${m}m ago` : `${h}h ago`;
        } else {
          lastText = `${diff}m ago`;
        }
      }

      msg += `
<b>${name}</b>

AED ${emp.daily.toFixed(0)} • ${emp.carsToday} cars today
AED ${emp.monthly.toFixed(0)} • ${emp.carsMonth} cars month

${lastText}

`;
    });

  sendLongMessage(chatId, msg);
}

function sendIdle(chatId) {
  const data = fetchData();

  const lastWork = data.lastWork;

  const now = new Date();

  let msg = `<b>IDLE EMPLOYEES</b>\n\n`;

  const idleList = [];

  Object.keys(lastWork).forEach((name) => {
    const last = new Date(lastWork[name]);

    const diff = Math.floor((now - last) / 60000);

    idleList.push({
      name,
      diff,
    });
  });

  idleList.sort((a, b) => b.diff - a.diff);

  idleList.forEach((emp) => {
    const h = Math.floor(emp.diff / 60);

    const m = emp.diff % 60;

    msg += `${emp.name}
${h}h ${m}m inactive

`;
  });

  sendLongMessage(chatId, msg);
}

