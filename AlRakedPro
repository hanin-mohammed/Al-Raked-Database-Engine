function sendVehicleSearch(chatId, plate) {
  const results = fetchVehicleSearch(plate);

  if (!results.length) {
    sendMessage(chatId, `No entries found for ${plate}`);

    return;
  }

  const occurrences = results.length;

  let msg = `<b>SEARCH: ${plate}</b>\n\n` + `Occurrences: ${occurrences}\n\n`;

  results.forEach((r, index) => {
    const date = Utilities.formatDate(
      new Date(r.timestamp),
      Session.getScriptTimeZone(),
      "dd MMM yyyy • HH:mm",
    );

    msg += `
<b>${index + 1}.</b>

🚘 ${r.plate}

🛠️ ${r.service}
💵 AED ${r.price || 0}

👨‍🔧 ${r.foreman || "-"}
👥 ${r.employee || "-"}

🏢 ${r.company || "-"}
🛢️ ${r.oil || "-"}

📅 ${date}
📂 ${r.sheet}

`;
  });

  sendLongMessage(chatId, msg);
}

